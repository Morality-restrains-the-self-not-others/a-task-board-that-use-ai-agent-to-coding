@startuml
!include <archimate/Archimate>

title daydaymoney Platform — Enterprise Landscape v1 (Current, 2026-07-01 16:30)

' ═══════════════════════════════════════════════════════════
' Business Layer
' ═══════════════════════════════════════════════════════════
rectangle "Business" {
  Business_Actor(developer, "Developer")
  Business_Actor(admin, "Platform Admin")
  Business_Actor(enterprise, "Enterprise Customer")

  Business_Service(ideSvc, "IDE Workspace Service")
  Business_Service(taskMgmt, "Task Management Service")
  Business_Service(cloudRes, "Cloud Resource Service")
  Business_Service(billingSvc, "Billing & License Service")

  Business_Process(devFlow, "Development Workflow")
  Business_Process(projOnboard, "Project Onboarding")

  Business_Object(project, "Project")
  Business_Object(workspace, "Workspace")
}

' ═══════════════════════════════════════════════════════════
' Application Layer
' ═══════════════════════════════════════════════════════════
rectangle "Application" {
  Application_Component(gateway, "API Gateway (APISIX)")
  Application_Component(djangoApp, "Django SaaS Platform")
  Application_Component(authSvc, "Auth Service")
  Application_Component(gitOauthSvc, "Git OAuth Service")
  Application_Component(providerSvc, "Provider Service")
  Application_Component(gitSvc, "Git Service")
  Application_Component(ciCdSvc, "CI/CD Runner Service")
  Application_Component(sseSvc, "Task SSE Service")

  Application_Service(authAPI, "Authentication API")
  Application_Service(projectAPI, "Project Management API")
  Application_Service(credAPI, "Credential Management API")
  Application_Service(billingAPI, "Billing API")

  Application_Interface(restAPI, "REST API")
  Application_Interface(webSocket, "WebSocket / SSE")

  Application_DataObject(userDB, "User & Auth Data")
  Application_DataObject(projectDB, "Project Data")
  Application_DataObject(billingDB, "Billing Data")
}

' ═══════════════════════════════════════════════════════════
' Technology Layer
' ═══════════════════════════════════════════════════════════
rectangle "Technology" {
  Technology_Device(lb, "Load Balancer")
  Technology_Node(appNode, "Application Host")
  Technology_Node(dbNode, "Database Host")
  Technology_Node(cacheNode, "Cache Host")

  Technology_SystemSoftware(docker, "Docker Engine")
  Technology_SystemSoftware(nginx, "Nginx")
  Technology_SystemSoftware(djangoRuntime, "Django (Python)")

  Technology_Service(postgres, "PostgreSQL")
  Technology_Service(redis, "Redis")
  Technology_Service(kafka, "Kafka")
  Technology_Service(gitlabInstance, "GitLab Instance")

  Technology_Artifact(dockerImg, "Docker Images")
  Technology_Artifact(staticAssets, "Static Assets")

  Technology_CommunicationNetwork(internalNet, "Internal Network (Docker Bridge)")
  Technology_CommunicationNetwork(externalNet, "External Network")
}

' ═══════════════════════════════════════════════════════════
' Cross-Layer Relationships
' ═══════════════════════════════════════════════════════════
Rel_Serving(gateway, restAPI, "routes")
Rel_Realization(djangoApp, projectAPI, "serves")
Rel_Realization(djangoApp, billingAPI, "serves")
Rel_Realization(authSvc, authAPI, "serves")
Rel_Realization(gitSvc, credAPI, "serves")

Rel_Assignment(appNode, djangoApp, "hosts")
Rel_Assignment(appNode, authSvc, "hosts")
Rel_Assignment(appNode, gateway, "hosts")
Rel_Assignment(dbNode, postgres, "runs")
Rel_Assignment(cacheNode, redis, "runs")

Rel_Composition(docker, djangoApp, "containerized")
Rel_Serving(postgres, djangoApp, "stores")
Rel_Serving(redis, djangoApp, "caches")
Rel_Serving(kafka, djangoApp, "events")

Rel_Flow(developer, devFlow, "triggers")
Rel_Serving(projectAPI, taskMgmt, "enables")
Rel_Serving(authAPI, developer, "authenticates")

@enduml
