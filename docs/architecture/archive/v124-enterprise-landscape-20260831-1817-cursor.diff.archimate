    <element xsi:type="archimate:Artifact" id="id-v124-el-ghrel" name="GitHub Release 新 tag"/>
    <element xsi:type="archimate:Artifact" id="id-v124-el-oldpem" name="taskGateway/certs 与 db PEM 作 SSOT [DEPRECATED]"/>
