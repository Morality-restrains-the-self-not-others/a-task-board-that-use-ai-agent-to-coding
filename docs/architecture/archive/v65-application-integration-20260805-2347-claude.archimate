    <!-- VIEW 2: v65 Target — 夜间巡检与自愈数据流 -->
    <!-- ══════════════════════════════════════════════════════ -->
    <element xsi:type="archimate:ArchimateDiagramModel" name="v65 Target — 夜间巡检与自愈数据流" id="view-sweep-topology">
      <documentation>Target topology: cron → NightlyTestSweep → (random 30% unit-test sweep) 40+ sub-repos; on failure → claude-agent fix loop (reproduce → fix → re-verify → commit → push); unresolved → UNIT_TEST_DEBT.md; daily report. Shared random_test_runner.sh serves sweep + sub-repo pre-commit hooks.</documentation>

      <!-- cronHost -->
      <child xsi:type="archimate:DiagramObject" id="do-cronhost" archimateElement="cronHost">
        <bounds x="24" y="24" width="150" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="conn-cron-sweep"
          source="do-cronhost" target="do-sweep"
          archimateRelationship="rel-cron-sweep"/>
      </child>

      <!-- NightlySweep -->
      <child xsi:type="archimate:DiagramObject" id="do-sweep" archimateElement="nightlySweep"
        targetConnections="conn-cron-sweep conn-runner-sweep">
        <bounds x="220" y="24" width="180" height="70"/>
        <sourceConnection xsi:type="archimate:Connection" id="conn-sweep-repos"
          source="do-sweep" target="do-repos"
          archimateRelationship="rel-sweep-repos"/>
        <sourceConnection xsi:type="archimate:Connection" id="conn-sweep-agent"
          source="do-sweep" target="do-agent"
          archimateRelationship="rel-sweep-agent"/>
        <sourceConnection xsi:type="archimate:Connection" id="conn-sweep-debt"
          source="do-sweep" target="do-debt"
          archimateRelationship="rel-sweep-debt"/>
        <sourceConnection xsi:type="archimate:Connection" id="conn-sweep-report"
          source="do-sweep" target="do-report"
          archimateRelationship="rel-sweep-report"/>
      </child>

      <!-- sharedRunner -->
      <child xsi:type="archimate:DiagramObject" id="do-runner" archimateElement="sharedRunner">
        <bounds x="24" y="240" width="150" height="60"/>
        <sourceConnection xsi:type="archimate:Connection" id="conn-runner-sweep"
          source="do-runner" target="do-sweep"
          archimateRelationship="rel-runner-sweep"/>
        <sourceConnection xsi:type="archimate:Connection" id="conn-runner-repos"
          source="do-runner" target="do-repos"
          archimateRelationship="rel-runner-repos"/>
      </child>

      <!-- 40+ repos pool -->
      <child xsi:type="archimate:DiagramObject" id="do-repos" archimateElement="devRepos"
        targetConnections="conn-sweep-repos conn-agent-repos conn-runner-repos">
        <bounds x="460" y="24" width="200" height="70"/>
