    <element xsi:type="archimate:ApplicationComponent" name="Kafka Consumers (Go)" id="kafkaConsumers"/>
    <element xsi:type="archimate:ApplicationComponent" name="APISIX Gateway (:18081) [MODIFIED v63]" id="gateway"/>
    <element xsi:type="archimate:DataObject" name="Kafka Domain Events Bus" id="kafkaBroker"/>
