  <!-- FOLDER: Implementation & Migration -->
  <!-- ══════════════════════════════════════════════════════════ -->
    <folder name="Implementation" id="folder-impl" type="implementation_migration">
    <element xsi:type="archimate:Plateau" name="Plateau v63 — RBAC current (custom roles + group resources)" id="plateauV63"/>
    <element xsi:type="archimate:Plateau" name="Plateau v64 — WeChat identity unified (target)" id="plateauV64"/>
    <element xsi:type="archimate:Gap" name="Gap v63→v64: single-app WeChat login, bare openid, no bind/unbind, in-memory pending" id="gapWx"/>
    <element xsi:type="archimate:WorkPackage" name="WP1 (v64): wechat_identity + multi-app OAuth + matching + bind/unbind (D1-D5)" id="wpIdentity"/>
    <element xsi:type="archimate:WorkPackage" name="WP2 (v64): taskBill callback chain — persistent pending + idempotent fulfill (D6-D8)" id="wpPayment"/>
    <element xsi:type="archimate:Plateau" name="Plateau v65 — Nightly test sweep + auto-fix (target)" id="plateauV65"/>
    <element xsi:type="archimate:Gap" name="Gap: random unit-test gate fires only on commit — low-frequency repos hide failures for long; no auto-fix loop at night" id="gapSweep"/>
    <element xsi:type="archimate:WorkPackage" name="WP1: extract shared random_test_runner.sh + refactor 6 pre-commit templates + deploy lib to sub-repos + CI check (D1)" id="wpLib"/>
    <element xsi:type="archimate:WorkPackage" name="WP2: nightly_test_sweep.py orchestrator + bash entry (window guard, flock, budget, dry-run) (D2)" id="wpSweep"/>
    <element xsi:type="archimate:WorkPackage" name="WP3: claude-agent fix loop + UNIT_TEST_DEBT ledger + cron install + daily report (D3-D4)" id="wpFix"/>
  </folder>

