<?xml version="1.0" encoding="UTF-8"?>
<archimate:model
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:archimate="http://www.archimatetool.com/archimate"
    xsi:schemaLocation="http://www.archimatetool.com/archimate http://www.archimatetool.com/archimate"
    identifier="model-v65-nightly-test-sweep-20260805">

  <name xml:lang="en">v65 Nightly Test Sweep + Auto-Fix</name>
  <purpose>v65 target (2026-08-05): Nightly (00:00-08:00) random unit-test sweep across all ~40 sub-repos (shared lib random_test_runner.sh SSOT, 30% ratio), auto-fix via claude-agent headless Claude Code (reproduce → fix → re-verify → commit → push to main), unresolved failures appended to UNIT_TEST_DEBT.md ledger (7-day dedup), daily report. Base = v64 WeChat identity (target). Includes migration view (v64→v65) and sweep topology view.</purpose>

  <!-- ══════════════════════════════════════════════════════════ -->
  <!-- FOLDER: Application Layer -->
  <!-- ══════════════════════════════════════════════════════════ -->
  <folder name="Application" id="folder-app" type="application">
    <element xsi:type="archimate:ApplicationComponent" name="taskAuth (:8003) PDP + WeChat Identity [MODIFIED v64]" id="taskAuth"/>
    <element xsi:type="archimate:ApplicationComponent" name="taskGitOauth (:8002)" id="taskGitOauth"/>
