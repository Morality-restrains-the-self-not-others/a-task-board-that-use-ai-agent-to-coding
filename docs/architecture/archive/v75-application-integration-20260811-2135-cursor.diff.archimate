<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="application-integration v75 变迁 (v74→v75)" id="id-v75diff01">
  <folder name="Application" id="id-v75diff-app" type="application">
    <element xsi:type="archimate:ApplicationComponent" id="app-fe-roles" name="taskFE PeopleRoles [NEW v75]"/>
    <element xsi:type="archimate:ApplicationComponent" id="app-fe-access" name="taskFE PeopleAccess [MODIFIED v75]"/>
    <element xsi:type="archimate:ApplicationComponent" id="app-taskAuth" name="taskAuth [MODIFIED v75]"/>
    <element xsi:type="archimate:ApplicationComponent" id="app-taskTenant" name="taskTenantService [MODIFIED v75]"/>
    <element xsi:type="archimate:DataObject" id="do-auth-role" name="auth_role"/>
    <element xsi:type="archimate:DataObject" id="do-rrg" name="auth_role_resource_group"/>
    <element xsi:type="archimate:DataObject" id="do-mrole" name="tenant_member_role [MODIFIED v75]"/>
    <element xsi:type="archimate:DataObject" id="do-grole" name="tenant_group_role [MODIFIED v75]"/>
    <element xsi:type="archimate:DataObject" id="do-seed" name="auth_resource_group people.roles* [NEW v75]"/>
  </folder>
  <folder name="Implementation &amp; Migration" id="id-v75diff-im" type="implementation_migration">
    <element xsi:type="archimate:Plateau" id="pl-v74" name="Plateau v74"/>
    <element xsi:type="archimate:Plateau" id="pl-v75" name="Plateau v75"/>
    <element xsi:type="archimate:Gap" id="gap-v75" name="Gap: reusable role mgmt + multi-role"/>
    <element xsi:type="archimate:WorkPackage" id="wp-v75" name="WP: tenant-role-management-v75"/>
  </folder>
  <folder name="Relations" id="id-v75diff-rel" type="relations">
    <element xsi:type="archimate:FlowRelationship" id="rel-fe-roles-auth" source="app-fe-roles" target="app-taskAuth" name="roles CRUD + resource-groups"/>
    <element xsi:type="archimate:FlowRelationship" id="rel-fe-access-tt" source="app-fe-access" target="app-taskTenant" name="PUT/DELETE role_names"/>
    <element xsi:type="archimate:AccessRelationship" id="rel-auth-role" source="app-taskAuth" target="do-auth-role" name="W roles"/>
    <element xsi:type="archimate:AccessRelationship" id="rel-auth-rrg" source="app-taskAuth" target="do-rrg" name="W grants"/>
    <element xsi:type="archimate:AccessRelationship" id="rel-auth-seed" source="app-taskAuth" target="do-seed" name="seed catalog"/>
    <element xsi:type="archimate:AccessRelationship" id="rel-tt-mrole" source="app-taskTenant" target="do-mrole" name="replace-all/delete"/>
    <element xsi:type="archimate:AccessRelationship" id="rel-tt-grole" source="app-taskTenant" target="do-grole" name="replace-all/delete"/>
    <element xsi:type="archimate:AssociationRelationship" id="rel-pl74-gap" source="pl-v74" target="gap-v75"/>
    <element xsi:type="archimate:RealizationRelationship" id="rel-wp-gap" source="wp-v75" target="gap-v75"/>
    <element xsi:type="archimate:AssociationRelationship" id="rel-wp-pl75" source="wp-v75" target="pl-v75"/>
  </folder>
  <folder name="Views" id="id-v75diff-views" type="diagrams">
    <element xsi:type="archimate:ArchimateDiagramModel" id="view-mig" name="架构变迁 v74→v75 — tenant-role-management">
      <child xsi:type="archimate:DiagramObject" id="do-pl74" archimateElement="pl-v74">
        <bounds x="48" y="48" width="140" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="conn-pl74-gap" source="do-pl74" target="do-gap" archimateRelationship="rel-pl74-gap"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="do-gap" targetConnections="conn-pl74-gap conn-wp-gap" archimateElement="gap-v75">
        <bounds x="240" y="48" width="220" height="55"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="do-wp" archimateElement="wp-v75">
        <bounds x="240" y="160" width="220" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="conn-wp-gap" source="do-wp" target="do-gap" archimateRelationship="rel-wp-gap"/>
        <sourceConnection xsi:type="archimate:Connection" id="conn-wp-pl75" source="do-wp" target="do-pl75" archimateRelationship="rel-wp-pl75"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="do-pl75" targetConnections="conn-wp-pl75" archimateElement="pl-v75">
        <bounds x="520" y="160" width="140" height="55"/>
      </child>
    </element>
    <element xsi:type="archimate:ArchimateDiagramModel" id="view-flow" name="v75 Target — role management data flow">
      <child xsi:type="archimate:DiagramObject" id="d-fe-roles" archimateElement="app-fe-roles">
        <bounds x="48" y="48" width="150" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="c-fe-roles-auth" source="d-fe-roles" target="d-auth" archimateRelationship="rel-fe-roles-auth"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="d-fe-access" archimateElement="app-fe-access">
        <bounds x="48" y="160" width="150" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="c-fe-access-tt" source="d-fe-access" target="d-tt" archimateRelationship="rel-fe-access-tt"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="d-auth" targetConnections="c-fe-roles-auth" archimateElement="app-taskAuth">
        <bounds x="260" y="48" width="140" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="c-auth-role" source="d-auth" target="d-role" archimateRelationship="rel-auth-role"/>
        <sourceConnection xsi:type="archimate:Connection" id="c-auth-rrg" source="d-auth" target="d-rrg" archimateRelationship="rel-auth-rrg"/>
        <sourceConnection xsi:type="archimate:Connection" id="c-auth-seed" source="d-auth" target="d-seed" archimateRelationship="rel-auth-seed"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="d-tt" targetConnections="c-fe-access-tt" archimateElement="app-taskTenant">
        <bounds x="260" y="160" width="140" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="c-tt-mrole" source="d-tt" target="d-mrole" archimateRelationship="rel-tt-mrole"/>
        <sourceConnection xsi:type="archimate:Connection" id="c-tt-grole" source="d-tt" target="d-grole" archimateRelationship="rel-tt-grole"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="d-role" targetConnections="c-auth-role" archimateElement="do-auth-role">
        <bounds x="460" y="20" width="140" height="45"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="d-rrg" targetConnections="c-auth-rrg" archimateElement="do-rrg">
        <bounds x="460" y="80" width="160" height="45"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="d-seed" targetConnections="c-auth-seed" archimateElement="do-seed">
        <bounds x="460" y="140" width="180" height="45"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="d-mrole" targetConnections="c-tt-mrole" archimateElement="do-mrole">
        <bounds x="460" y="200" width="180" height="45"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="d-grole" targetConnections="c-tt-grole" archimateElement="do-grole">
        <bounds x="460" y="260" width="180" height="45"/>
      </child>
    </element>
  </folder>
</archimate:model>
