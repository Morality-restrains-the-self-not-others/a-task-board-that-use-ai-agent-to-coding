  |<#LightGreen>  </>| 🟢 [NEW] v55 — 本次新增 |
  |<#LightYellow> </>| 🟡 [MODIFIED] v55 — 本次修改 |
  |<#LightPink>   </>| 🔴 [DEPRECATED] v55 — 本次废弃 |
  |<#White>       </>| 无标记 — 已有组件，本次未变 |
endlegend

' ═══════════════════════════════════════
' Plateau v54 (current) — Before
' ═══════════════════════════════════════
rectangle "Plateau v54 (current)" as P54 #LightGray {
  Technology_Node(nginx54, "Nginx (:443)")
  Technology_Node(apisix54, "APISIX (:18081)")
  Technology_Node(django54, "Django (:8001)")
  Application_Component(djangoSpa54, "Django SPA Shell\n(_serve_spa_shell)")

  note right of nginx54
    location /api/ → APISIX
    location /     → Django
  end note
