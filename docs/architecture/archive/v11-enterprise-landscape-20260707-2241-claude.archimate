  <element xsi:type="archimate:RealizationRelationship" id="rel1" source="taskCloudSvc" target="vendorCredAPI"/>
  <element xsi:type="archimate:RealizationRelationship" id="rel2" source="aiProvider" target="imageMarketAPI"/>
  <element xsi:type="archimate:ServingRelationship" id="rel3" source="vendorCredAPI" target="imageMarket"/>
  <element xsi:type="archimate:ServingRelationship" id="rel4" source="imageMarketAPI" target="imageMarket"/>
