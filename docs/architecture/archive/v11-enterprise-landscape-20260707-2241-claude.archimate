  <folder name="Views" id="f-views" type="diagrams">
    <element xsi:type="archimate:ArchiMateDiagramModel" name="架构变迁 v10→v11 — 厂商测试密钥" id="view-migration">
      <child xsi:type="archimate:DiagramObject" id="do-platV10" archimateElement="platV10">
