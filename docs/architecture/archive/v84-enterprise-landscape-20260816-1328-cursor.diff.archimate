      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v84elsd-d-fe" targetConnections="id-v84elsd-c-sse-fe" archimateElement="id-v84elsd-fe">
        <bounds x="500" y="96" width="160" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v84elsd-c-fe-cloud" source="id-v84elsd-d-fe" target="id-v84elsd-d-cloud" archimateRelationship="id-v84elsd-rel-fe-cloud"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v84elsd-d-aliyun" targetConnections="id-v84elsd-c-cloud-aliyun" archimateElement="id-v84elsd-aliyun">
