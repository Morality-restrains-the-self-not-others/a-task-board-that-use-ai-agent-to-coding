    <element xsi:type="archimate:BusinessActor" id="id-v105-biz-tenant" name="普通租户"/>
    <element xsi:type="archimate:BusinessService" id="id-v105-biz-setrole" name="设置测试角色"/>
    <element xsi:type="archimate:BusinessService" id="id-v105-biz-setmode" name="设置区域开发/发布模式"/>
    <element xsi:type="archimate:BusinessService" id="id-v105-biz-usedev" name="使用开发模式 GitLab 区域"/>
