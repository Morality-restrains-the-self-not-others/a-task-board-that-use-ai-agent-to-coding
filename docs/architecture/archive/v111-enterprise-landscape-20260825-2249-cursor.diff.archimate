<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="enterprise-landscape v111 变迁 (v110→v111)" id="id-v111eldiff01">
  <folder name="Business" id="id-v111el-biz" type="business">
    <element xsi:type="archimate:BusinessActor" id="id-v111-biz-user" name="登录用户"/>
    <element xsi:type="archimate:BusinessActor" id="id-v111-biz-admin" name="平台超管"/>
    <element xsi:type="archimate:BusinessProcess" id="id-v111-biz-cust" name="用户入口登录 [NEW v111]"/>
    <element xsi:type="archimate:BusinessProcess" id="id-v111-biz-adm" name="管理员入口登录 [NEW v111]"/>
    <element xsi:type="archimate:BusinessProcess" id="id-v111-biz-self" name="查看自己的登录历史 [NEW v111]"/>
    <element xsi:type="archimate:BusinessProcess" id="id-v111-biz-other" name="查看指定用户登录历史 [NEW v111]"/>
  </folder>
  <folder name="Application" id="id-v111el-app" type="application">
    <element xsi:type="archimate:ApplicationComponent" id="id-v111-app-fe" name="taskFE 账号中心 / 超管用户表 [MODIFIED v111]"/>
    <element xsi:type="archimate:ApplicationComponent" id="id-v111-app-auth" name="taskAuth [MODIFIED v111]"/>
    <element xsi:type="archimate:DataObject" id="id-v111-data-hist" name="auth_login_history [NEW v111]"/>
  </folder>
  <folder name="Implementation &amp; Migration" id="id-v111el-im" type="implementation_migration">
    <element xsi:type="archimate:Plateau" id="id-v111-pl-v110" name="Plateau v110"/>
    <element xsi:type="archimate:Plateau" id="id-v111-pl-v111" name="Plateau v111"/>
    <element xsi:type="archimate:Gap" id="id-v111-gap" name="Gap: 用户看不到登录 IP 历史"/>
    <element xsi:type="archimate:WorkPackage" id="id-v111-wp" name="WP-login-history"/>
  </folder>
  <folder name="Relations" id="id-v111el-rel" type="relations">
    <element xsi:type="archimate:AssignmentRelationship" id="id-v111-rel-user-cust" source="id-v111-biz-user" target="id-v111-biz-cust"/>
    <element xsi:type="archimate:AssignmentRelationship" id="id-v111-rel-admin-adm" source="id-v111-biz-admin" target="id-v111-biz-adm"/>
    <element xsi:type="archimate:AssignmentRelationship" id="id-v111-rel-user-self" source="id-v111-biz-user" target="id-v111-biz-self"/>
    <element xsi:type="archimate:AssignmentRelationship" id="id-v111-rel-admin-other" source="id-v111-biz-admin" target="id-v111-biz-other"/>
    <element xsi:type="archimate:FlowRelationship" id="id-v111-rel-user-fe" source="id-v111-biz-user" target="id-v111-app-fe" name="打开登录历史"/>
    <element xsi:type="archimate:FlowRelationship" id="id-v111-rel-admin-fe" source="id-v111-biz-admin" target="id-v111-app-fe" name="打开用户登录历史"/>
    <element xsi:type="archimate:FlowRelationship" id="id-v111-rel-fe-auth" source="id-v111-app-fe" target="id-v111-app-auth" name="GET login-history"/>
    <element xsi:type="archimate:AccessRelationship" id="id-v111-rel-auth-hist" source="id-v111-app-auth" target="id-v111-data-hist" name="read/write"/>
    <element xsi:type="archimate:TriggeringRelationship" id="id-v111-rel-pl110-gap" source="id-v111-pl-v110" target="id-v111-gap" name="identifies"/>
    <element xsi:type="archimate:RealizationRelationship" id="id-v111-rel-wp-gap" source="id-v111-wp" target="id-v111-gap"/>
    <element xsi:type="archimate:RealizationRelationship" id="id-v111-rel-wp-pl111" source="id-v111-wp" target="id-v111-pl-v111"/>
  </folder>
  <folder name="Views" id="id-v111el-views" type="diagrams">
    <element xsi:type="archimate:ArchimateDiagramModel" id="id-v111-el-view-mig" name="架构变迁 v110→v111 — login-history">
      <child xsi:type="archimate:DiagramObject" id="id-v111-el-do-pl110" archimateElement="id-v111-pl-v110">
        <bounds x="48" y="48" width="140" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v111-el-c-pl110-gap" source="id-v111-el-do-pl110" target="id-v111-el-do-gap" archimateRelationship="id-v111-rel-pl110-gap"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v111-el-do-gap" targetConnections="id-v111-el-c-pl110-gap id-v111-el-c-wp-gap" archimateElement="id-v111-gap">
        <bounds x="240" y="48" width="360" height="55"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v111-el-do-wp" archimateElement="id-v111-wp">
        <bounds x="240" y="160" width="360" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v111-el-c-wp-gap" source="id-v111-el-do-wp" target="id-v111-el-do-gap" archimateRelationship="id-v111-rel-wp-gap"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v111-el-c-wp-pl111" source="id-v111-el-do-wp" target="id-v111-el-do-pl111" archimateRelationship="id-v111-rel-wp-pl111"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v111-el-do-pl111" targetConnections="id-v111-el-c-wp-pl111" archimateElement="id-v111-pl-v111">
        <bounds x="640" y="160" width="200" height="55"/>
      </child>
    </element>
    <element xsi:type="archimate:ArchimateDiagramModel" id="id-v111-el-view-topo" name="v111 Target — 登录历史业务">
      <child xsi:type="archimate:DiagramObject" id="id-v111-el-do-user" archimateElement="id-v111-biz-user">
        <bounds x="48" y="16" width="120" height="50"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v111-el-c-user-cust" source="id-v111-el-do-user" target="id-v111-el-do-cust" archimateRelationship="id-v111-rel-user-cust"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v111-el-c-user-self" source="id-v111-el-do-user" target="id-v111-el-do-self" archimateRelationship="id-v111-rel-user-self"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v111-el-c-user-fe" source="id-v111-el-do-user" target="id-v111-el-do-fe" archimateRelationship="id-v111-rel-user-fe"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v111-el-do-admin" archimateElement="id-v111-biz-admin">
        <bounds x="48" y="200" width="120" height="50"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v111-el-c-admin-adm" source="id-v111-el-do-admin" target="id-v111-el-do-adm" archimateRelationship="id-v111-rel-admin-adm"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v111-el-c-admin-other" source="id-v111-el-do-admin" target="id-v111-el-do-other" archimateRelationship="id-v111-rel-admin-other"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v111-el-c-admin-fe" source="id-v111-el-do-admin" target="id-v111-el-do-fe" archimateRelationship="id-v111-rel-admin-fe"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v111-el-do-cust" targetConnections="id-v111-el-c-user-cust" archimateElement="id-v111-biz-cust">
        <bounds x="220" y="16" width="160" height="50"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v111-el-do-self" targetConnections="id-v111-el-c-user-self" archimateElement="id-v111-biz-self">
        <bounds x="220" y="80" width="180" height="50"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v111-el-do-adm" targetConnections="id-v111-el-c-admin-adm" archimateElement="id-v111-biz-adm">
        <bounds x="220" y="176" width="160" height="50"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v111-el-do-other" targetConnections="id-v111-el-c-admin-other" archimateElement="id-v111-biz-other">
        <bounds x="220" y="240" width="200" height="50"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v111-el-do-fe" targetConnections="id-v111-el-c-user-fe id-v111-el-c-admin-fe" archimateElement="id-v111-app-fe">
        <bounds x="460" y="112" width="220" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v111-el-c-fe-auth" source="id-v111-el-do-fe" target="id-v111-el-do-auth" archimateRelationship="id-v111-rel-fe-auth"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v111-el-do-auth" targetConnections="id-v111-el-c-fe-auth" archimateElement="id-v111-app-auth">
        <bounds x="720" y="112" width="140" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v111-el-c-auth-hist" source="id-v111-el-do-auth" target="id-v111-el-do-hist" archimateRelationship="id-v111-rel-auth-hist"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v111-el-do-hist" targetConnections="id-v111-el-c-auth-hist" archimateElement="id-v111-data-hist">
        <bounds x="900" y="112" width="200" height="55"/>
      </child>
    </element>
  </folder>
</archimate:model>
