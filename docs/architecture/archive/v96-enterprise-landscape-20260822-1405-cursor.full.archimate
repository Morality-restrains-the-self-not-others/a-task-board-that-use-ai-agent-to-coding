<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="enterprise-landscape v96 full (after v96)" id="id-v96elfull01">
  <folder name="Business" id="id-v96elf-biz" type="business">
    <element xsi:type="archimate:BusinessActor" id="id-v96-biz-admin" name="系统超级管理员"/>
    <element xsi:type="archimate:BusinessActor" id="id-v96-biz-tenant" name="租户成员"/>
    <element xsi:type="archimate:BusinessService" id="id-v96-biz-orders" name="订单记录"/>
    <element xsi:type="archimate:BusinessService" id="id-v96-biz-psview" name="查阅订单分账 [NEW v96]"/>
    <element xsi:type="archimate:BusinessService" id="id-v96-biz-torders" name="租户订单列表"/>
  </folder>
  <folder name="Application" id="id-v96elf-app" type="application">
    <element xsi:type="archimate:ApplicationComponent" id="id-v96-el-fe" name="taskFE [MODIFIED v96]"/>
    <element xsi:type="archimate:ApplicationComponent" id="id-v96-el-bill" name="taskBill [MODIFIED v96]"/>
  </folder>
  <folder name="Implementation &amp; Migration" id="id-v96elf-im" type="implementation_migration">
    <element xsi:type="archimate:Plateau" id="id-v96-el-pl95" name="Plateau v95"/>
    <element xsi:type="archimate:Plateau" id="id-v96-el-pl96" name="Plateau v96"/>
    <element xsi:type="archimate:Gap" id="id-v96-el-gap" name="Gap: 订单展开无分账对象与金额"/>
    <element xsi:type="archimate:WorkPackage" id="id-v96-el-wp" name="WP-admin-order-profit-sharing"/>
  </folder>
  <folder name="Relations" id="id-v96elf-rel" type="relations">
    <element xsi:type="archimate:AssignmentRelationship" id="id-v96-rel-admin-orders" source="id-v96-biz-admin" target="id-v96-biz-orders"/>
    <element xsi:type="archimate:AssignmentRelationship" id="id-v96-rel-admin-ps" source="id-v96-biz-admin" target="id-v96-biz-psview"/>
    <element xsi:type="archimate:AssignmentRelationship" id="id-v96-rel-tenant-to" source="id-v96-biz-tenant" target="id-v96-biz-torders"/>
    <element xsi:type="archimate:ServingRelationship" id="id-v96-rel-fe-orders" source="id-v96-el-fe" target="id-v96-biz-orders"/>
    <element xsi:type="archimate:ServingRelationship" id="id-v96-rel-fe-ps" source="id-v96-el-fe" target="id-v96-biz-psview"/>
    <element xsi:type="archimate:ServingRelationship" id="id-v96-rel-fe-to" source="id-v96-el-fe" target="id-v96-biz-torders"/>
    <element xsi:type="archimate:FlowRelationship" id="id-v96-rel-orders-ps" source="id-v96-biz-orders" target="id-v96-biz-psview" name="expand row"/>
    <element xsi:type="archimate:FlowRelationship" id="id-v96-rel-ps-bill" source="id-v96-biz-psview" target="id-v96-el-bill" name="GET admin order detail"/>
    <element xsi:type="archimate:FlowRelationship" id="id-v96-rel-to-bill" source="id-v96-biz-torders" target="id-v96-el-bill" name="GET tenant order — no profit_sharing"/>
    <element xsi:type="archimate:AssociationRelationship" id="id-v96-rel-el-pl95-gap" source="id-v96-el-pl95" target="id-v96-el-gap"/>
    <element xsi:type="archimate:RealizationRelationship" id="id-v96-rel-el-wp-gap" source="id-v96-el-wp" target="id-v96-el-gap"/>
    <element xsi:type="archimate:AssociationRelationship" id="id-v96-rel-el-wp-pl96" source="id-v96-el-wp" target="id-v96-el-pl96"/>
  </folder>
  <folder name="Views" id="id-v96elf-views" type="diagrams">
    <element xsi:type="archimate:ArchimateDiagramModel" id="id-v96-elf-view-topo" name="v96 Full — 订单分账可见性拓扑">
      <child xsi:type="archimate:DiagramObject" id="id-v96-elfd-admin" archimateElement="id-v96-biz-admin">
        <bounds x="48" y="48" width="160" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v96-elfc-admin-orders" source="id-v96-elfd-admin" target="id-v96-elfd-orders" archimateRelationship="id-v96-rel-admin-orders"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v96-elfc-admin-ps" source="id-v96-elfd-admin" target="id-v96-elfd-ps" archimateRelationship="id-v96-rel-admin-ps"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v96-elfd-tenant" archimateElement="id-v96-biz-tenant">
        <bounds x="48" y="280" width="140" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v96-elfc-tenant-to" source="id-v96-elfd-tenant" target="id-v96-elfd-to" archimateRelationship="id-v96-rel-tenant-to"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v96-elfd-orders" targetConnections="id-v96-elfc-admin-orders id-v96-elfc-fe-orders" archimateElement="id-v96-biz-orders">
        <bounds x="260" y="48" width="140" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v96-elfc-orders-ps" source="id-v96-elfd-orders" target="id-v96-elfd-ps" archimateRelationship="id-v96-rel-orders-ps"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v96-elfd-ps" targetConnections="id-v96-elfc-admin-ps id-v96-elfc-orders-ps id-v96-elfc-fe-ps" archimateElement="id-v96-biz-psview">
        <bounds x="260" y="140" width="160" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v96-elfc-ps-bill" source="id-v96-elfd-ps" target="id-v96-elfd-bill" archimateRelationship="id-v96-rel-ps-bill"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v96-elfd-to" targetConnections="id-v96-elfc-tenant-to id-v96-elfc-fe-to" archimateElement="id-v96-biz-torders">
        <bounds x="260" y="280" width="160" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v96-elfc-to-bill" source="id-v96-elfd-to" target="id-v96-elfd-bill" archimateRelationship="id-v96-rel-to-bill"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v96-elfd-fe" archimateElement="id-v96-el-fe">
        <bounds x="48" y="140" width="140" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v96-elfc-fe-orders" source="id-v96-elfd-fe" target="id-v96-elfd-orders" archimateRelationship="id-v96-rel-fe-orders"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v96-elfc-fe-ps" source="id-v96-elfd-fe" target="id-v96-elfd-ps" archimateRelationship="id-v96-rel-fe-ps"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v96-elfc-fe-to" source="id-v96-elfd-fe" target="id-v96-elfd-to" archimateRelationship="id-v96-rel-fe-to"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v96-elfd-bill" targetConnections="id-v96-elfc-ps-bill id-v96-elfc-to-bill" archimateElement="id-v96-el-bill">
        <bounds x="480" y="200" width="140" height="55"/>
      </child>
    </element>
    <element xsi:type="archimate:ArchimateDiagramModel" id="id-v96-elf-view-mig" name="架构变迁 v95→v96 — admin-order-profit-sharing">
      <child xsi:type="archimate:DiagramObject" id="id-v96-elfd-pl95" archimateElement="id-v96-el-pl95">
        <bounds x="48" y="48" width="140" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v96-elfc-pl95-gap" source="id-v96-elfd-pl95" target="id-v96-elfd-gap" archimateRelationship="id-v96-rel-el-pl95-gap"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v96-elfd-gap" targetConnections="id-v96-elfc-pl95-gap id-v96-elfc-wp-gap" archimateElement="id-v96-el-gap">
        <bounds x="240" y="48" width="420" height="55"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v96-elfd-wp" archimateElement="id-v96-el-wp">
        <bounds x="240" y="160" width="300" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v96-elfc-wp-gap" source="id-v96-elfd-wp" target="id-v96-elfd-gap" archimateRelationship="id-v96-rel-el-wp-gap"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v96-elfc-wp-pl96" source="id-v96-elfd-wp" target="id-v96-elfd-pl96" archimateRelationship="id-v96-rel-el-wp-pl96"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v96-elfd-pl96" targetConnections="id-v96-elfc-wp-pl96" archimateElement="id-v96-el-pl96">
        <bounds x="580" y="160" width="140" height="55"/>
      </child>
    </element>
  </folder>
</archimate:model>
