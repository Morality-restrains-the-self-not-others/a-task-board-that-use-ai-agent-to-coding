  <folder name="Motivation" id="id-folder-motivation-v4" type="motivation">
    <element xsi:type="archimate:Driver" name="Django runserver 单线程拥塞" id="drv-single-thread"/>
    <element xsi:type="archimate:Driver" name="进程内 self-call 死锁" id="drv-self-call"/>
    <element xsi:type="archimate:Goal" name="容器交互流量与 CRUD 隔离" id="goal-traffic-isolation"/>
    <element xsi:type="archimate:Requirement" name="120s git-push 期间 heartbeat 仍 &lt;1s 响应" id="req-heartbeat-sla"/>
  </folder>
  <folder name="Implementation &amp; Migration" id="id-folder-implementation-v4" type="implementation_migration">
    <element xsi:type="archimate:Plateau" name="Plateau v1 — Current Baseline (Django 全量 API)" id="plateau-v1"/>
