    <element xsi:type="archimate:WorkPackage" name="WP Phase 2 — taskAgentSupport inbound 业务下沉" id="wp-phase2"/>
    <element xsi:type="archimate:Deliverable" name="Deliverable: v4 application-integration 架构文件" id="deliv-v4-arch"/>
  </folder>
