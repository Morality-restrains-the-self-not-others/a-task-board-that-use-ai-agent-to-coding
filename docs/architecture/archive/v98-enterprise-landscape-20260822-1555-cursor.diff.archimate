    <element xsi:type="archimate:RealizationRelationship" id="id-v98-rel-el-wp-gap" source="id-v98-el-wp" target="id-v98-el-gap"/>
    <element xsi:type="archimate:AssociationRelationship" id="id-v98-rel-el-wp-pl97" source="id-v98-el-wp" target="id-v98-el-pl97"/>
  </folder>
  <folder name="Views" id="id-v98eld-views" type="diagrams">
    <element xsi:type="archimate:ArchimateDiagramModel" id="id-v98-el-view-mig" name="架构变迁 v96→v98 — instruction-idle-recycle">
