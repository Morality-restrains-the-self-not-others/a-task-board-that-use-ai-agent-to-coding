<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="enterprise-landscape v98 变迁 (v96→v98)" id="id-v98eldiff01">
  <folder name="Business" id="id-v98eld-biz" type="business">
    <element xsi:type="archimate:BusinessActor" id="id-v98-biz-member" name="租户成员"/>
    <element xsi:type="archimate:BusinessService" id="id-v98-biz-instruct" name="向镜像下指令"/>
    <element xsi:type="archimate:BusinessService" id="id-v98-biz-idle" name="指令闲置自动回收 [NEW v98]"/>
  </folder>
  <folder name="Application" id="id-v98eld-app" type="application">
    <element xsi:type="archimate:ApplicationComponent" id="id-v98-el-osjs" name="onlineServiceJS [MODIFIED v98]"/>
    <element xsi:type="archimate:ApplicationComponent" id="id-v98-el-cred" name="taskCredentialService [MODIFIED v98]"/>
    <element xsi:type="archimate:ApplicationComponent" id="id-v98-el-cloud" name="taskCloudService [MODIFIED v98]"/>
    <element xsi:type="archimate:ApplicationComponent" id="id-v98-el-ev" name="taskEvents idle timer [MODIFIED v98]"/>
  </folder>
  <folder name="Implementation &amp; Migration" id="id-v98eld-im" type="implementation_migration">
    <element xsi:type="archimate:Plateau" id="id-v98-el-pl96" name="Plateau v96"/>
    <element xsi:type="archimate:Plateau" id="id-v98-el-pl97" name="Plateau v98"/>
    <element xsi:type="archimate:Gap" id="id-v98-el-gap" name="Gap: 指令跑完容器仍挂着不回收"/>
