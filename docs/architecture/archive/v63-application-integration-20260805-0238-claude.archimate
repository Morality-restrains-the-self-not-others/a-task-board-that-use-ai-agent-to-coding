        <bounds x="50" y="350" width="280" height="65"/>
        <sourceConnection xsi:type="archimate:Connection" id="conn-wp2-gap"
          source="do-wp2" target="do-gap"
          archimateRelationship="rel-wp2-gap"/>
        <sourceConnection xsi:type="archimate:Connection" id="conn-wp2-plateau"
          source="do-wp2" target="do-plateauV63"
          archimateRelationship="rel-wp2-plateauV61"/>
      </child>

      <!-- Plateau v61 -->
      <child xsi:type="archimate:DiagramObject" id="do-plateauV63" archimateElement="plateauV63"
        targetConnections="conn-wp1-plateau conn-wp2-plateau">
        <bounds x="350" y="280" width="280" height="80"/>
      </child>
    </element>

    <!-- ══════════════════════════════════════════════════════ -->
