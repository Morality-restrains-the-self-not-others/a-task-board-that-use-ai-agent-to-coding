          source="do-gw" target="do-aicomment"
          archimateRelationship="rel-gw-aicomment"/>
      </child>

      <!-- shareLib/authz [MODIFIED] -->
      <child xsi:type="archimate:DiagramObject" id="do-authz" archimateElement="shareLibAuthz" targetConnections="conn-dep-rr">
        <bounds x="210" y="24" width="160" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="conn-authz-auth"
          source="do-authz" target="do-auth"
          archimateRelationship="rel-authz-auth"/>
