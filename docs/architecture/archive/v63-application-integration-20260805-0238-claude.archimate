<?xml version="1.0" encoding="UTF-8"?>
<archimate:model
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:archimate="http://www.archimatetool.com/archimate"
    xsi:schemaLocation="http://www.archimatetool.com/archimate http://www.archimatetool.com/archimate"
    identifier="model-v63-rbac-20260805">

  <name xml:lang="en">v63 RBAC Custom-Role + Group Resource Assignment</name>
  <purpose>v63 target (merged): tenant-scoped custom roles + permission-code driven authz (RequirePerm) + v62 group_admin/resource-group assignment (RequirePerm) + X-Tenant-Perms injection + hard switch off is_admin/is_superuser + group-role inheritance Phase 1 + taskFE frontend adoption. Merges the parallel v62 line (group_admin, resource→group) with the custom-role line. Includes migration view (v62→v63).</purpose>

  <!-- ══════════════════════════════════════════════════════════ -->
  <!-- FOLDER: Application Layer -->
  <!-- ══════════════════════════════════════════════════════════ -->
  <folder name="Application" id="folder-app" type="application">
    <element xsi:type="archimate:ApplicationComponent" name="taskAuth (:8003) PDP [MODIFIED v63]" id="taskAuth"/>
    <element xsi:type="archimate:ApplicationComponent" name="taskGitOauth (:8002)" id="taskGitOauth"/>
    <element xsi:type="archimate:ApplicationComponent" name="taskTenantService (:8020) [MODIFIED v63]" id="taskTenant"/>
    <element xsi:type="archimate:ApplicationComponent" name="taskProjectService (:8016) [MODIFIED v63]" id="taskProject"/>
    <element xsi:type="archimate:ApplicationComponent" name="taskTaskService (:8021) [MODIFIED v63]" id="taskTask"/>
    <element xsi:type="archimate:ApplicationComponent" name="taskAIComment (:8022)" id="taskAIComment"/>
    <element xsi:type="archimate:ApplicationComponent" name="taskCloudService (:8018) [MODIFIED v63]" id="taskCloud"/>
    <element xsi:type="archimate:ApplicationComponent" name="taskBill (:8004) [MODIFIED v63]" id="taskBill"/>
    <element xsi:type="archimate:ApplicationComponent" name="taskEvents (:8023) [MODIFIED v63]" id="taskEvents"/>
    <element xsi:type="archimate:ApplicationComponent" name="taskFE (SPA) [NEW v63]" id="taskFE"/>
    <element xsi:type="archimate:ApplicationComponent" name="shareLib/authz Thin Client [MODIFIED v63]" id="shareLibAuthz"/>
    <element xsi:type="archimate:ApplicationComponent" name="Kafka Consumers (Go)" id="kafkaConsumers"/>
    <element xsi:type="archimate:ApplicationComponent" name="APISIX Gateway (:18081) [MODIFIED v63]" id="gateway"/>
    <element xsi:type="archimate:DataObject" name="Kafka Domain Events Bus" id="kafkaBroker"/>
    <element xsi:type="archimate:DataObject" name="taskAuth DB (+4 RBAC tables, auth_role.company_id) [MODIFIED v63]" id="taskAuthDB"/>
    <element xsi:type="archimate:DataObject" name="taskGitOauth DB" id="taskGitOauthDB"/>
    <element xsi:type="archimate:DataObject" name="taskTenant DB (+member_role +group_role) [MODIFIED v63]" id="taskTenantDB"/>
    <element xsi:type="archimate:DataObject" name="taskProject DB" id="taskProjectDB"/>
    <element xsi:type="archimate:DataObject" name="taskTask DB" id="taskTaskDB"/>
    <element xsi:type="archimate:DataObject" name="taskCloud DB" id="taskCloudDB"/>
    <element xsi:type="archimate:DataObject" name="taskBill DB" id="taskBillDB"/>
    <element xsi:type="archimate:ApplicationEvent" name="RoleChanged [NEW v63]" id="evtRoleChanged"/>
    <element xsi:type="archimate:ApplicationEvent" name="TenantMemberRoleChanged" id="evtTenantRole"/>
    <element xsi:type="archimate:ApplicationEvent" name="TenantGroupRoleChanged [NEW v63]" id="evtGroupRole"/>
    <element xsi:type="archimate:ApplicationEvent" name="CompanyCreated (existing)" id="evtCompanyCreated"/>
    <element xsi:type="archimate:ApplicationEvent" name="CompanyMemberAdded (existing)" id="evtMemberAdded"/>
    <element xsi:type="archimate:ApplicationEvent" name="GroupAdminAssigned/Revoked [NEW v63]" id="evtGroupAdmin"/>
    <element xsi:type="archimate:ApplicationEvent" name="ResourceAssigned/RevokedFromGroup [NEW v63]" id="evtResAssign"/>
    <element xsi:type="archimate:ApplicationEvent" name="MemberAdded/RemovedFromGroup [NEW v63]" id="evtGroupMember"/>

    <element xsi:type="archimate:ApplicationComponent" name="is_admin/is_superuser direct check [DEPRECATED v63]" id="oldIsAdmin"/>
    <element xsi:type="archimate:ApplicationComponent" name="policy.go creator hardcode [DEPRECATED v63]" id="oldPolicy"/>
    <element xsi:type="archimate:ApplicationComponent" name="RequireRole priority check [DEPRECATED v63]" id="oldRequireRole"/>
  </folder>

  <!-- ══════════════════════════════════════════════════════════ -->
  <!-- FOLDER: Implementation & Migration -->
  <!-- ══════════════════════════════════════════════════════════ -->
  <folder name="Implementation" id="folder-impl" type="implementation_migration">
    <element xsi:type="archimate:Plateau" name="Plateau v62 — fixed roles + group_admin + resource→group" id="plateauV62"/>
    <element xsi:type="archimate:Plateau" name="Plateau v63 — custom roles + perm-code authz + group resource + hard switch" id="plateauV63"/>
    <element xsi:type="archimate:Gap" name="Gap: no custom roles, no perm-code authz, group resource not perm-driven, is_admin remains" id="gapMerged"/>
    <element xsi:type="archimate:WorkPackage" name="WP1: shareLib/authz RequirePerm + PDP perm-set + role CRUD + group roles (D1-D4)" id="wpCustom"/>
    <element xsi:type="archimate:WorkPackage" name="WP2: APISIX X-Tenant-Perms + taskFE 37 sites + hard-switch backfill (D5-D8)" id="wpHardSwitch"/>
  </folder>

  <!-- ══════════════════════════════════════════════════════════ -->
  <!-- FOLDER: Relations -->
  <!-- ══════════════════════════════════════════════════════════ -->
  <folder name="Relations" id="folder-rels" type="relations">
    <!-- Gateway routing -->
    <element xsi:type="archimate:FlowRelationship" name="forward-auth → PDP ← X-User-Roles, X-Tenant-Perms" id="rel-gw-auth" source="gateway" target="taskAuth"/>
    <element xsi:type="archimate:FlowRelationship" name="" id="rel-gw-tenant" source="gateway" target="taskTenant"/>
    <element xsi:type="archimate:FlowRelationship" name="" id="rel-gw-project" source="gateway" target="taskProject"/>
    <element xsi:type="archimate:FlowRelationship" name="" id="rel-gw-task" source="gateway" target="taskTask"/>
    <element xsi:type="archimate:FlowRelationship" name="" id="rel-gw-aicomment" source="gateway" target="taskAIComment"/>
    <element xsi:type="archimate:FlowRelationship" name="" id="rel-gw-cloud" source="gateway" target="taskCloud"/>
    <element xsi:type="archimate:FlowRelationship" name="" id="rel-gw-bill" source="gateway" target="taskBill"/>
    <element xsi:type="archimate:FlowRelationship" name="SPA static assets" id="rel-gw-fe" source="gateway" target="taskFE"/>
    <!-- authz thin client → services (permission-code driven) -->
    <element xsi:type="archimate:ServingRelationship" name="CheckPerm HTTP fallback" id="rel-authz-auth" source="shareLibAuthz" target="taskAuth"/>
    <element xsi:type="archimate:ServingRelationship" name="RequirePerm(member:*)" id="rel-authz-tenant" source="shareLibAuthz" target="taskTenant"/>
    <element xsi:type="archimate:ServingRelationship" name="RequirePerm(cloud:*)" id="rel-authz-cloud" source="shareLibAuthz" target="taskCloud"/>
    <element xsi:type="archimate:ServingRelationship" name="RequirePerm(billing:*)" id="rel-authz-bill" source="shareLibAuthz" target="taskBill"/>
    <element xsi:type="archimate:ServingRelationship" name="RequirePerm(project:*)" id="rel-authz-project" source="shareLibAuthz" target="taskProject"/>
    <element xsi:type="archimate:ServingRelationship" name="RequirePerm(task:*)" id="rel-authz-task" source="shareLibAuthz" target="taskTask"/>
    <!-- Kafka event flow -->
    <element xsi:type="archimate:FlowRelationship" name="consume" id="rel-kafka-consumers" source="kafkaBroker" target="kafkaConsumers"/>
    <element xsi:type="archimate:FlowRelationship" name="+CompanyCreated→tenant_admin, +MemberAdded→member" id="rel-cons-tenant" source="kafkaConsumers" target="taskTenant"/>
    <element xsi:type="archimate:FlowRelationship" name="" id="rel-cons-auth" source="kafkaConsumers" target="taskAuth"/>
    <element xsi:type="archimate:FlowRelationship" name="" id="rel-cons-project" source="kafkaConsumers" target="taskProject"/>
    <element xsi:type="archimate:FlowRelationship" name="" id="rel-cons-cloud" source="kafkaConsumers" target="taskCloud"/>
    <element xsi:type="archimate:FlowRelationship" name="+RoleChanged→cache invalidation" id="rel-cons-events" source="kafkaConsumers" target="taskEvents"/>
    <!-- Data ownership (Access) -->
    <element xsi:type="archimate:AccessRelationship" name="write" id="rel-auth-db" source="taskAuth" target="taskAuthDB"/>
    <element xsi:type="archimate:AccessRelationship" name="write" id="rel-git-db" source="taskGitOauth" target="taskGitOauthDB"/>
    <element xsi:type="archimate:AccessRelationship" name="write" id="rel-tenant-db" source="taskTenant" target="taskTenantDB"/>
    <element xsi:type="archimate:AccessRelationship" name="write" id="rel-project-db" source="taskProject" target="taskProjectDB"/>
    <element xsi:type="archimate:AccessRelationship" name="write" id="rel-task-db" source="taskTask" target="taskTaskDB"/>
    <element xsi:type="archimate:AccessRelationship" name="write" id="rel-cloud-db" source="taskCloud" target="taskCloudDB"/>
    <element xsi:type="archimate:AccessRelationship" name="write" id="rel-bill-db" source="taskBill" target="taskBillDB"/>
    <!-- Domain events -->
    <element xsi:type="archimate:FlowRelationship" name="publish" id="rel-auth-roleevt" source="taskAuth" target="evtRoleChanged"/>
    <element xsi:type="archimate:FlowRelationship" name="publish" id="rel-tenant-roleevt" source="taskTenant" target="evtTenantRole"/>
    <element xsi:type="archimate:FlowRelationship" name="publish" id="rel-tenant-groupevt" source="taskTenant" target="evtGroupRole"/>
    <element xsi:type="archimate:FlowRelationship" name="to bus (existing)" id="rel-coc-kafka" source="evtCompanyCreated" target="kafkaBroker"/>
    <element xsi:type="archimate:FlowRelationship" name="to bus (existing)" id="rel-ma-kafka" source="evtMemberAdded" target="kafkaBroker"/>
    <element xsi:type="archimate:FlowRelationship" name="publish" id="rel-tenant-gradmin" source="taskTenant" target="evtGroupAdmin"/>
    <element xsi:type="archimate:FlowRelationship" name="publish" id="rel-tenant-resassign" source="taskTenant" target="evtResAssign"/>
    <element xsi:type="archimate:FlowRelationship" name="publish" id="rel-tenant-grpmmbr" source="taskTenant" target="evtGroupMember"/>
    <element xsi:type="archimate:FlowRelationship" name="to bus" id="rel-gradmin-kafka" source="evtGroupAdmin" target="kafkaBroker"/>
    <element xsi:type="archimate:FlowRelationship" name="to bus" id="rel-resassign-kafka" source="evtResAssign" target="kafkaBroker"/>
    <element xsi:type="archimate:FlowRelationship" name="to bus" id="rel-grpmmbr-kafka" source="evtGroupMember" target="kafkaBroker"/>

    <element xsi:type="archimate:FlowRelationship" name="to bus" id="rel-roleevt-kafka" source="evtRoleChanged" target="kafkaBroker"/>
    <element xsi:type="archimate:FlowRelationship" name="to bus" id="rel-tenantroleevt-kafka" source="evtTenantRole" target="kafkaBroker"/>
    <element xsi:type="archimate:FlowRelationship" name="to bus" id="rel-groupevt-kafka" source="evtGroupRole" target="kafkaBroker"/>
    <!-- Deprecated associations -->
    <element xsi:type="archimate:AssociationRelationship" name="" id="rel-dep-isadmin-auth" source="oldIsAdmin" target="taskAuth"/>
    <element xsi:type="archimate:AssociationRelationship" name="" id="rel-dep-isadmin-tenant" source="oldIsAdmin" target="taskTenant"/>
    <element xsi:type="archimate:AssociationRelationship" name="" id="rel-dep-policy" source="oldPolicy" target="taskTenant"/>
    <element xsi:type="archimate:AssociationRelationship" name="" id="rel-dep-requirerole" source="oldRequireRole" target="shareLibAuthz"/>
    <!-- Migration: Plateau → Gap → WorkPackage → Plateau -->
    <element xsi:type="archimate:AssociationRelationship" name="triggers" id="rel-plateauV60-gap" source="plateauV62" target="gapMerged"/>
    <element xsi:type="archimate:RealizationRelationship" name="closes" id="rel-wp1-gap" source="wpCustom" target="gapMerged"/>
    <element xsi:type="archimate:RealizationRelationship" name="closes" id="rel-wp2-gap" source="wpHardSwitch" target="gapMerged"/>
    <element xsi:type="archimate:RealizationRelationship" name="delivers" id="rel-wp1-plateauV61" source="wpCustom" target="plateauV63"/>
    <element xsi:type="archimate:RealizationRelationship" name="delivers" id="rel-wp2-plateauV61" source="wpHardSwitch" target="plateauV63"/>
  </folder>

  <!-- ══════════════════════════════════════════════════════════ -->
  <!-- FOLDER: Views -->
  <!-- ══════════════════════════════════════════════════════════ -->
  <folder name="Views" id="folder-views" type="diagrams">

    <!-- ══════════════════════════════════════════════════════ -->
    <!-- VIEW 1: 架构变迁 v60→v61 — 自定义角色权限体系 -->
    <!-- ══════════════════════════════════════════════════════ -->
    <element xsi:type="archimate:ArchimateDiagramModel" name="架构变迁 v62→v63 — 自定义角色 + 小组资源分配" id="view-migration">
      <documentation>Implementation &amp; Migration: Plateau v60 → Gap → WorkPackages → Plateau v61</documentation>

      <!-- Plateau v60 -->
      <child xsi:type="archimate:DiagramObject" id="do-plateauV62" archimateElement="plateauV62">
        <bounds x="50" y="100" width="220" height="80"/>
        <sourceConnection xsi:type="archimate:Connection" id="conn-v60-gap"
          source="do-plateauV62" target="do-gap"
          archimateRelationship="rel-plateauV60-gap"/>
      </child>

      <!-- Gap -->
      <child xsi:type="archimate:DiagramObject" id="do-gap" archimateElement="gapMerged"
        targetConnections="conn-v60-gap conn-wp1-gap conn-wp2-gap">
        <bounds x="350" y="100" width="280" height="80"/>
      </child>

      <!-- WP Custom Roles -->
      <child xsi:type="archimate:DiagramObject" id="do-wp1" archimateElement="wpCustom">
        <bounds x="50" y="250" width="280" height="65"/>
        <sourceConnection xsi:type="archimate:Connection" id="conn-wp1-gap"
          source="do-wp1" target="do-gap"
          archimateRelationship="rel-wp1-gap"/>
        <sourceConnection xsi:type="archimate:Connection" id="conn-wp1-plateau"
          source="do-wp1" target="do-plateauV63"
          archimateRelationship="rel-wp1-plateauV61"/>
      </child>

      <!-- WP Hard Switch -->
