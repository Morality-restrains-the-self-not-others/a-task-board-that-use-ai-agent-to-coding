  <folder name="Views" id="id-v95eld-views" type="diagrams">
    <element xsi:type="archimate:ArchimateDiagramModel" id="id-v95-el-view-mig" name="架构变迁 v94→v95 — referral-qualification-revoke">
      <child xsi:type="archimate:DiagramObject" id="id-v95-eld-pl94" archimateElement="id-v95-el-pl94">
        <bounds x="48" y="48" width="140" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v95-elc-pl94-gap" source="id-v95-eld-pl94" target="id-v95-eld-gap" archimateRelationship="id-v95-rel-el-pl94-gap"/>
