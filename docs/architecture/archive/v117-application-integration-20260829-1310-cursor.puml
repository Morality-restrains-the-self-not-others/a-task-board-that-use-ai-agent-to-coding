@startuml
!include <archimate/Archimate>

title v117 — 开放式邀请链接 2026-08-29 13:10

Application_Component(taskFE, "taskFE SPA")
note right of taskFE
  邀请人：单次/开放开关
  待处理列表已用/上限
  @author: cursor @2026-08-29 13:10
end note

Application_Component(gw, "taskGateway / APISIX")
Application_Component(ten, "taskTenantService")
note right of ten
  invite/validate/join
  原子 use_count；single 行为不变
  @author: cursor @2026-08-29 13:10
end note

Application_Component(ev, "taskEvents")
note right of ev
  消费 INVITATION_CREATED / MEMBER_JOINED
end note

Application_DataObject(inv, "tenant_invitation")
note right of inv
  link_kind max_uses use_count
  @author: cursor @2026-08-29 13:10
end note

Application_DataObject(red, "tenant_invitation_redemption")
note right of red
  UNIQUE(invitation_id, user_id)
  @author: cursor @2026-08-29 13:10
end note

Business_Event(evCreated, "INVITATION_CREATED")
note right of evCreated
  payload link_kind max_uses
end note

Business_Event(evJoined, "MEMBER_JOINED")
note right of evJoined
  invitation_exhausted
end note

Rel_Flow(taskFE, gw, "invite / validate / join")
Rel_Flow(gw, ten, "tenant members APIs")
Rel_Access(ten, inv, "INSERT/UPDATE")
