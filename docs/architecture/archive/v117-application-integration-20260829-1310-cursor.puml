Rel_Flow(ten, evCreated, "after invite commit")
Rel_Flow(ten, evJoined, "after join commit")
Rel_Flow(ten, ev, "publish Kafka")

Implementation_Plateau(plateauV116, "Plateau v116 链接仅单次")
Implementation_Plateau(plateauV117, "Plateau v117 开放邀请链接")
Implementation_Gap(gapOpen, "Gap: 邀请链接只能使用一次")
Implementation_WorkPackage(wpOpen, "WP-open-invite-link")
Rel_Triggering(plateauV116, gapOpen, "identifies")
Rel_Realization(wpOpen, gapOpen, "closes")
Rel_Realization(wpOpen, plateauV117, "delivers")

