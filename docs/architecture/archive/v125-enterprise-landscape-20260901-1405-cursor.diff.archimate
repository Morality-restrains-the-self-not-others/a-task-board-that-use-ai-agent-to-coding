      <child xsi:type="archimate:DiagramObject" id="id-v125-el-do-sso" archimateElement="id-v125-el-sso">
        <bounds x="48" y="180" width="200" height="50"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v125-el-c-sso-auth" source="id-v125-el-do-sso" target="id-v125-el-do-auth" archimateRelationship="id-v125-el-rel-sso-auth"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v125-el-do-auth" targetConnections="id-v125-el-c-sso-auth" archimateElement="id-v125-el-auth">
        <bounds x="280" y="180" width="160" height="50"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v125-el-c-auth-aip" source="id-v125-el-do-auth" target="id-v125-el-do-aip" archimateRelationship="id-v125-el-rel-auth-aip"/>
