      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v125-el-do-aip" targetConnections="id-v125-el-c-fe-aip id-v125-el-c-auth-aip" archimateElement="id-v125-el-aip">
        <bounds x="660" y="80" width="180" height="50"/>
