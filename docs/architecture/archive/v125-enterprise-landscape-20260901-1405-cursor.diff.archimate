        <bounds x="860" y="140" width="280" height="50"/>
      </child>
    </element>
    <element xsi:type="archimate:ArchimateDiagramModel" id="id-v125-el-view-topo" name="v125 Current — 租户镜像市场申请">
      <child xsi:type="archimate:DiagramObject" id="id-v125-el-do-mem" archimateElement="id-v125-el-member">
        <bounds x="48" y="80" width="140" height="50"/>
