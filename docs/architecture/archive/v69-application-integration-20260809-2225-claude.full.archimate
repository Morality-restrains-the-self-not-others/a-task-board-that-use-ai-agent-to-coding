    <element xsi:type="archimate:ArchimateDiagramModel" name="v65 Target — 夜间巡检与自愈数据流" id="view-sweep-topology">
      <documentation>Target topology: cron → NightlyTestSweep → (random 30% unit-test sweep) 40+ sub-repos; on failure → claude-agent fix loop (reproduce → fix → re-verify → commit → push); unresolved → UNIT_TEST_DEBT.md; daily report. Shared random_test_runner.sh serves sweep + sub-repo pre-commit hooks.</documentation>

      <!-- cronHost -->
      <child xsi:type="archimate:DiagramObject" id="do-cronhost" archimateElement="cronHost">
        <bounds x="24" y="24" width="150" height="55"/>
