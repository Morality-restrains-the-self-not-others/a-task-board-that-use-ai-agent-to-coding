<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="application-integration v75 全量 (post-change)" id="id-v75full01">
  <folder name="Application" id="id-v75full-app" type="application">
    <element xsi:type="archimate:ApplicationComponent" id="app-fe" name="taskFE"/>
    <element xsi:type="archimate:ApplicationComponent" id="app-fe-roles" name="taskFE PeopleRoles [NEW v75]"/>
    <element xsi:type="archimate:ApplicationComponent" id="app-fe-access" name="taskFE PeopleAccess [MODIFIED v75]"/>
    <element xsi:type="archimate:ApplicationComponent" id="app-fe-invite" name="taskFE PeopleInvite"/>
    <element xsi:type="archimate:ApplicationComponent" id="app-taskTenant" name="taskTenantService [MODIFIED v75]"/>
    <element xsi:type="archimate:ApplicationComponent" id="app-taskAuth" name="taskAuth [MODIFIED v75]"/>
    <element xsi:type="archimate:ApplicationComponent" id="app-authz" name="shareLib/authz"/>
    <element xsi:type="archimate:DataObject" id="do-inv" name="tenant_invitation"/>
    <element xsi:type="archimate:DataObject" id="do-auth-role" name="auth_role"/>
    <element xsi:type="archimate:DataObject" id="do-rrg" name="auth_role_resource_group"/>
    <element xsi:type="archimate:DataObject" id="do-mrole" name="tenant_member_role [MODIFIED v75]"/>
    <element xsi:type="archimate:DataObject" id="do-grole" name="tenant_group_role [MODIFIED v75]"/>
    <element xsi:type="archimate:DataObject" id="do-seed" name="auth_resource_group [NEW people.roles*]"/>
  </folder>
  <folder name="Implementation &amp; Migration" id="id-v75full-im" type="implementation_migration">
    <element xsi:type="archimate:Plateau" id="pl-v74" name="Plateau v74"/>
    <element xsi:type="archimate:Plateau" id="pl-v75" name="Plateau v75 [NEW]"/>
    <element xsi:type="archimate:Gap" id="gap-v75" name="Gap: reusable role mgmt + multi-role"/>
    <element xsi:type="archimate:WorkPackage" id="wp-v75" name="WP: tenant-role-management-v75"/>
  </folder>
  <folder name="Relations" id="id-v75full-rel" type="relations">
    <element xsi:type="archimate:CompositionRelationship" id="rel-fe-roles-comp" source="app-fe" target="app-fe-roles" name="contains"/>
    <element xsi:type="archimate:CompositionRelationship" id="rel-fe-access-comp" source="app-fe" target="app-fe-access" name="contains"/>
    <element xsi:type="archimate:CompositionRelationship" id="rel-fe-invite-comp" source="app-fe" target="app-fe-invite" name="contains"/>
    <element xsi:type="archimate:FlowRelationship" id="rel-fe-roles-auth" source="app-fe-roles" target="app-taskAuth" name="roles CRUD + resource-groups"/>
    <element xsi:type="archimate:FlowRelationship" id="rel-fe-access-tt" source="app-fe-access" target="app-taskTenant" name="PUT/DELETE role_names"/>
    <element xsi:type="archimate:FlowRelationship" id="rel-fe-invite-tt" source="app-fe-invite" target="app-taskTenant" name="invite + pending_grants"/>
    <element xsi:type="archimate:FlowRelationship" id="rel-tt-auth-apply" source="app-taskTenant" target="app-taskAuth" name="apply-member-grants"/>
    <element xsi:type="archimate:AccessRelationship" id="rel-tt-inv" source="app-taskTenant" target="do-inv" name="R/W invitation"/>
    <element xsi:type="archimate:AccessRelationship" id="rel-auth-role" source="app-taskAuth" target="do-auth-role" name="W roles"/>
    <element xsi:type="archimate:AccessRelationship" id="rel-auth-rrg" source="app-taskAuth" target="do-rrg" name="W grants"/>
    <element xsi:type="archimate:AccessRelationship" id="rel-auth-seed" source="app-taskAuth" target="do-seed" name="seed"/>
    <element xsi:type="archimate:AccessRelationship" id="rel-tt-mrole" source="app-taskTenant" target="do-mrole" name="multi-role"/>
    <element xsi:type="archimate:AccessRelationship" id="rel-tt-grole" source="app-taskTenant" target="do-grole" name="multi-role"/>
    <element xsi:type="archimate:ServingRelationship" id="rel-authz-auth" source="app-authz" target="app-taskAuth" name="RequireRegion"/>
    <element xsi:type="archimate:AssociationRelationship" id="rel-pl74-gap" source="pl-v74" target="gap-v75"/>
    <element xsi:type="archimate:RealizationRelationship" id="rel-wp-gap" source="wp-v75" target="gap-v75"/>
    <element xsi:type="archimate:AssociationRelationship" id="rel-wp-pl75" source="wp-v75" target="pl-v75"/>
  </folder>
  <folder name="Views" id="id-v75full-views" type="diagrams">
    <element xsi:type="archimate:ArchimateDiagramModel" id="view-full" name="v75 全量拓扑 — tenant-role-management">
      <child xsi:type="archimate:DiagramObject" id="d-fe" archimateElement="app-fe">
        <bounds x="48" y="120" width="100" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="c-fe-roles" source="d-fe" target="d-fe-roles" archimateRelationship="rel-fe-roles-comp"/>
        <sourceConnection xsi:type="archimate:Connection" id="c-fe-access" source="d-fe" target="d-fe-access" archimateRelationship="rel-fe-access-comp"/>
        <sourceConnection xsi:type="archimate:Connection" id="c-fe-invite" source="d-fe" target="d-fe-invite" archimateRelationship="rel-fe-invite-comp"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="d-fe-roles" targetConnections="c-fe-roles" archimateElement="app-fe-roles">
        <bounds x="200" y="48" width="150" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="c-roles-auth" source="d-fe-roles" target="d-auth" archimateRelationship="rel-fe-roles-auth"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="d-fe-access" targetConnections="c-fe-access" archimateElement="app-fe-access">
        <bounds x="200" y="120" width="150" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="c-access-tt" source="d-fe-access" target="d-tt" archimateRelationship="rel-fe-access-tt"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="d-fe-invite" targetConnections="c-fe-invite" archimateElement="app-fe-invite">
        <bounds x="200" y="200" width="150" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="c-invite-tt" source="d-fe-invite" target="d-tt" archimateRelationship="rel-fe-invite-tt"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="d-tt" targetConnections="c-access-tt c-invite-tt" archimateElement="app-taskTenant">
        <bounds x="400" y="120" width="150" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="c-tt-auth" source="d-tt" target="d-auth" archimateRelationship="rel-tt-auth-apply"/>
        <sourceConnection xsi:type="archimate:Connection" id="c-tt-inv" source="d-tt" target="d-inv" archimateRelationship="rel-tt-inv"/>
        <sourceConnection xsi:type="archimate:Connection" id="c-tt-mrole" source="d-tt" target="d-mrole" archimateRelationship="rel-tt-mrole"/>
        <sourceConnection xsi:type="archimate:Connection" id="c-tt-grole" source="d-tt" target="d-grole" archimateRelationship="rel-tt-grole"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="d-auth" targetConnections="c-roles-auth c-tt-auth" archimateElement="app-taskAuth">
        <bounds x="400" y="48" width="150" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="c-auth-role" source="d-auth" target="d-role" archimateRelationship="rel-auth-role"/>
        <sourceConnection xsi:type="archimate:Connection" id="c-auth-rrg" source="d-auth" target="d-rrg" archimateRelationship="rel-auth-rrg"/>
        <sourceConnection xsi:type="archimate:Connection" id="c-auth-seed" source="d-auth" target="d-seed" archimateRelationship="rel-auth-seed"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="d-authz" archimateElement="app-authz">
        <bounds x="400" y="260" width="120" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="c-authz-auth" source="d-authz" target="d-auth" archimateRelationship="rel-authz-auth"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="d-inv" targetConnections="c-tt-inv" archimateElement="do-inv">
        <bounds x="600" y="200" width="140" height="45"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="d-role" targetConnections="c-auth-role" archimateElement="do-auth-role">
        <bounds x="600" y="20" width="120" height="45"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="d-rrg" targetConnections="c-auth-rrg" archimateElement="do-rrg">
        <bounds x="600" y="80" width="160" height="45"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="d-seed" targetConnections="c-auth-seed" archimateElement="do-seed">
        <bounds x="600" y="140" width="180" height="45"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="d-mrole" targetConnections="c-tt-mrole" archimateElement="do-mrole">
        <bounds x="600" y="260" width="180" height="45"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="d-grole" targetConnections="c-tt-grole" archimateElement="do-grole">
        <bounds x="600" y="320" width="180" height="45"/>
      </child>
    </element>
    <element xsi:type="archimate:ArchimateDiagramModel" id="view-mig" name="架构变迁 v74→v75 — tenant-role-management">
      <child xsi:type="archimate:DiagramObject" id="do-pl74" archimateElement="pl-v74">
        <bounds x="48" y="48" width="140" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="conn-pl74-gap" source="do-pl74" target="do-gap" archimateRelationship="rel-pl74-gap"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="do-gap" targetConnections="conn-pl74-gap conn-wp-gap" archimateElement="gap-v75">
        <bounds x="240" y="48" width="220" height="55"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="do-wp" archimateElement="wp-v75">
        <bounds x="240" y="160" width="220" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="conn-wp-gap" source="do-wp" target="do-gap" archimateRelationship="rel-wp-gap"/>
        <sourceConnection xsi:type="archimate:Connection" id="conn-wp-pl75" source="do-wp" target="do-pl75" archimateRelationship="rel-wp-pl75"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="do-pl75" targetConnections="conn-wp-pl75" archimateElement="pl-v75">
        <bounds x="520" y="160" width="140" height="55"/>
      </child>
    </element>
  </folder>
</archimate:model>
