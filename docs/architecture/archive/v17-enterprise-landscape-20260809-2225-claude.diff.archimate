      </child>
      <child xsi:type="archimate:DiagramObject" id="do-wpMock" archimateElement="wpMock">
        <bounds x="740" y="80" width="360" height="60"/>
        <sourceConnection xsi:type="archimate:Connection" id="conn-wp-gap" source="do-wpMock" target="do-gapMock" archimateRelationship="rel-wp-gap"/>
        <sourceConnection xsi:type="archimate:Connection" id="conn-wp-v17" source="do-wpMock" target="do-plateauV17" archimateRelationship="rel-wp-plat"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="do-plateauV17" archimateElement="plateauV17" targetConnections="conn-wp-v17">
        <bounds x="740" y="190" width="360" height="50"/>
      </child>
    </element>

    <!-- 视图 2: v17 Target — 移除本机模拟启动拓扑 -->
    <element xsi:type="archimate:ArchiMateDiagramModel" name="v17 Target — 移除本机模拟启动链" id="view-topology">
      <child xsi:type="archimate:DiagramObject" id="do-feSvc" archimateElement="feSvc">
        <bounds x="40" y="60" width="220" height="60"/>
