<?xml version="1.0" encoding="UTF-8"?>
<archimate:model
    xmlns="http://www.opengroup.org/xsd/archimate/3.0/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:archimate="http://www.archimatetool.com/archimate"
    xsi:schemaLocation="http://www.opengroup.org/xsd/archimate/3.0/ http://www.opengroup.org/xsd/archimate/3.1/archimate3_Diagram.xsd"
    identifier="model-v17-el-20260809-2225">

  <name xml:lang="en">daydaymoney Enterprise Landscape v17 Target (v16→v17 变迁)</name>
  <purpose>移除本机容器模拟启动 — 🔴 mock_run_container (Flask :8796) / go_run_container (Go :8796) 两个本机 Docker 模拟运行器删除；🔴 taskContainerGateway mock-run-container 代理面 (start/stop/status/env-defaults) 删除；🔴 taskCloudService /api/internal/mock-run/* 删除；🟡 comment_csc_bootstrap mock/空平台分支改为报错拦截；🔴 taskFE「模拟启动」面板与 mockContainerStart 路由 flag 删除；容器启动统一走云端机器 (start-vm → CLOUD_SERVER_STARTED → ECS)</purpose>

  <folder name="Business" id="f-biz" type="business"/>
  <folder name="Application" id="f-app" type="application"/>
  <folder name="Technology" id="f-tech" type="technology"/>
  <folder name="Implementation" id="f-impl" type="implementation_migration"/>
  <folder name="Relations" id="f-rel" type="relations"/>

  <!-- Application Layer — v17 变更组件 -->
  <element xsi:type="archimate:ApplicationComponent" name="taskContainerGateway (Go :8014) [MODIFIED v17: mock-run-container 代理面删除]" id="containerGW"/>
  <element xsi:type="archimate:ApplicationComponent" name="taskCloudService (Go :8018) [MODIFIED v17: /api/internal/mock-run/* 删除 + comment_csc_bootstrap mock/空平台报错拦截]" id="taskCloudSvc"/>
  <element xsi:type="archimate:ApplicationComponent" name="taskFE (Vue SPA) [MODIFIED v17: 「模拟启动」面板/mockRun tab/mockContainerStart flag 删除]" id="feSvc"/>

  <!-- Technology Layer — v17 废弃运行器 -->
  <element xsi:type="archimate:Artifact" name="🔴 mock_run_container (Python Flask :8796) [DEPRECATED v17: 本机 Docker 模拟运行器 — 删除]" id="mockRunContainer"/>
  <element xsi:type="archimate:Artifact" name="🔴 go_run_container (Go :8796) [DEPRECATED v17: mock_run_container Go 重写 — 删除]" id="goRunContainer"/>

  <!-- Implementation & Migration — v17 架构变迁 -->
  <element xsi:type="archimate:Plateau" name="Plateau v16 — 插件 OIDC 白名单管理 (2026-08-08)" id="plateauV16"/>
  <element xsi:type="archimate:Plateau" name="Plateau v17 — 移除本机模拟启动 (2026-08-09)" id="plateauV17"/>
  <element xsi:type="archimate:Gap" name="Gap: 本机容器模拟启动与云端启动双轨并存 → 启动行为不统一、本机 Docker 依赖" id="gapMock"/>
  <element xsi:type="archimate:WorkPackage" name="WP-remove-local-mock-start (P1 删除运行器+编排 → P2 gateway/cloud 删除转发 → P3 FE 面板删除 → P4 comment bootstrap 报错拦截 → P5 测试清理+验证)" id="wpMock"/>

  <!-- Relationships -->
  <element xsi:type="archimate:FlowRelationship" id="rel-cgw-mrc" source="containerGW" target="mockRunContainer"/>
  <element xsi:type="archimate:FlowRelationship" id="rel-cloud-mrc" source="taskCloudSvc" target="mockRunContainer"/>
  <element xsi:type="archimate:FlowRelationship" id="rel-fe-mrc" source="feSvc" target="mockRunContainer"/>
  <element xsi:type="archimate:AssociationRelationship" id="rel-mrc-grc" source="mockRunContainer" target="goRunContainer"/>
  <element xsi:type="archimate:TriggeringRelationship" id="rel-trigger" source="plateauV16" target="gapMock"/>
  <element xsi:type="archimate:RealizationRelationship" id="rel-wp-gap" source="wpMock" target="gapMock"/>
  <element xsi:type="archimate:RealizationRelationship" id="rel-wp-plat" source="wpMock" target="plateauV17"/>

  <folder name="Views" id="f-views" type="diagrams">
    <!-- 视图 1: 架构变迁 v16→v17 -->
    <element xsi:type="archimate:ArchiMateDiagramModel" name="架构变迁 v16→v17 — 移除本机模拟启动" id="view-migration">
      <child xsi:type="archimate:DiagramObject" id="do-plateauV16" archimateElement="plateauV16">
        <bounds x="48" y="120" width="260" height="50"/>
