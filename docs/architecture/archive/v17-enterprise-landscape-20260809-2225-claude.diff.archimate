      </child>
      <child xsi:type="archimate:DiagramObject" id="do-containerGW" archimateElement="containerGW">
        <bounds x="320" y="60" width="240" height="60"/>
        <sourceConnection xsi:type="archimate:Connection" id="conn-cgw-mrc" source="do-containerGW" target="do-mockRunContainer" archimateRelationship="rel-cgw-mrc"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="do-taskCloudSvc" archimateElement="taskCloudSvc">
        <bounds x="320" y="180" width="240" height="60"/>
        <sourceConnection xsi:type="archimate:Connection" id="conn-cloud-mrc" source="do-taskCloudSvc" target="do-mockRunContainer" archimateRelationship="rel-cloud-mrc"/>
