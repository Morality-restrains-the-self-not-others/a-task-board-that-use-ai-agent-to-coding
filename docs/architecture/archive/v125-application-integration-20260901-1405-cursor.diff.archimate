    </element>
    <element xsi:type="archimate:ArchimateDiagramModel" id="id-v125-view-topo" name="v125 Current — 镜像市场申请与 SSO">
      <child xsi:type="archimate:DiagramObject" id="id-v125-do-fe" archimateElement="id-v125-app-fe">
        <bounds x="48" y="80" width="180" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v125-c-fe-gw" source="id-v125-do-fe" target="id-v125-do-gw" archimateRelationship="id-v125-rel-fe-gw"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v125-c-fe-auth" source="id-v125-do-fe" target="id-v125-do-auth" archimateRelationship="id-v125-rel-fe-auth"/>
