    </element>

    <element xsi:type="archimate:ArchiMateDiagramModel" name="v15 Target — relay selected image start" id="id-v15-view-topo">
      <child xsi:type="archimate:DiagramObject" id="id-v15-do-vue" archimateElement="id-v15-vue">
