<?xml version="1.0" encoding="UTF-8"?>
<archimate:model
    xmlns="http://www.opengroup.org/xsd/archimate/3.0/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:archimate="http://www.archimatetool.com/archimate"
    xsi:schemaLocation="http://www.opengroup.org/xsd/archimate/3.0/ http://www.opengroup.org/xsd/archimate/3.1/archimate3_Diagram.xsd"
    identifier="model-v15-ai-20260710-2009">

  <name xml:lang="en">AI Dev Platform — Application Integration v15 Target</name>
  <purpose>relayToTrae start resolves TenantInstalledImage and docker pull/run selected image</purpose>

  <folder name="Application" id="id-v15-f-app" type="application"/>
  <folder name="Technology" id="id-v15-f-tech" type="technology"/>
  <folder name="Relations" id="id-v15-f-rel" type="relations"/>
  <folder name="Implementation" id="id-v15-f-impl" type="implementation_migration"/>

  <!-- Application Components -->
  <element xsi:type="archimate:ApplicationComponent" name="🟡 Vue ServerConfig [MODIFIED v15]" id="id-v15-vue"/>
  <element xsi:type="archimate:ApplicationComponent" name="🟡 taskContainerGateway [MODIFIED v15]" id="id-v15-cgw"/>
  <element xsi:type="archimate:ApplicationComponent" name="taskCloudService" id="id-v15-cloud"/>
  <element xsi:type="archimate:ApplicationComponent" name="🟡 go_relayToTrae [MODIFIED v15]" id="id-v15-relay"/>
  <element xsi:type="archimate:ApplicationComponent" name="taskCredentialService" id="id-v15-cred"/>

  <!-- Technology -->
  <element xsi:type="archimate:Node" name="Docker Engine" id="id-v15-docker"/>

  <!-- Data -->
  <element xsi:type="archimate:DataObject" name="TenantInstalledImageRef" id="id-v15-img-ref"/>

  <!-- Flow Relations -->
  <element xsi:type="archimate:FlowRelationship" id="id-v15-flow-vue-cgw" source="id-v15-vue" target="id-v15-cgw" name="POST start + installed_image_id"/>
  <element xsi:type="archimate:FlowRelationship" id="id-v15-flow-cgw-cred" source="id-v15-cgw" target="id-v15-cred" name="token-init"/>
  <element xsi:type="archimate:FlowRelationship" id="id-v15-flow-cgw-cloud" source="id-v15-cgw" target="id-v15-cloud" name="resolve-image"/>
  <element xsi:type="archimate:FlowRelationship" id="id-v15-flow-cloud-cgw" source="id-v15-cloud" target="id-v15-cgw" name="image ref"/>
  <element xsi:type="archimate:FlowRelationship" id="id-v15-flow-cgw-relay" source="id-v15-cgw" target="id-v15-relay" name="POST /v1/start + image"/>
  <element xsi:type="archimate:FlowRelationship" id="id-v15-flow-relay-docker" source="id-v15-relay" target="id-v15-docker" name="docker pull + run"/>

  <!-- Implementation & Migration -->
  <element xsi:type="archimate:Plateau" name="Plateau v14 — relay Token cloud parity" id="id-v15-plat-v14"/>
  <element xsi:type="archimate:Plateau" name="🎯 Plateau v15 — relay selected image runtime" id="id-v15-plat-v15"/>
  <element xsi:type="archimate:Gap" name="Gap: relay 启动忽略用户所选镜像" id="id-v15-gap"/>
  <element xsi:type="archimate:WorkPackage" name="WP-v15-relay-start-selected-image" id="id-v15-wp"/>
  <element xsi:type="archimate:AssociationRelationship" id="id-v15-rel-plat14-gap" source="id-v15-plat-v14" target="id-v15-gap"/>
  <element xsi:type="archimate:RealizationRelationship" id="id-v15-rel-wp-gap" source="id-v15-wp" target="id-v15-gap"/>
  <element xsi:type="archimate:RealizationRelationship" id="id-v15-rel-wp-plat15" source="id-v15-wp" target="id-v15-plat-v15"/>
  <element xsi:type="archimate:CompositionRelationship" id="id-v15-rel-plat15-relay" source="id-v15-plat-v15" target="id-v15-relay"/>
  <element xsi:type="archimate:CompositionRelationship" id="id-v15-rel-plat15-cgw" source="id-v15-plat-v15" target="id-v15-cgw"/>

  <folder name="Views" id="id-v15-f-views" type="diagrams">
    <element xsi:type="archimate:ArchiMateDiagramModel" name="架构变迁 v14→v15 — relay 启动所选镜像" id="id-v15-view-migration">
      <child xsi:type="archimate:DiagramObject" id="id-v15-do-plat-v14" archimateElement="id-v15-plat-v14">
