    <element xsi:type="archimate:BusinessProcess" id="id-v114-el-view" name="查看启动日志 [MODIFIED v114]"/>
    <element xsi:type="archimate:BusinessProcess" id="id-v114-el-archive" name="归档启动日志到 COS [NEW v114]"/>
  </folder>
  <folder name="Application" id="id-v114el-app" type="application">
