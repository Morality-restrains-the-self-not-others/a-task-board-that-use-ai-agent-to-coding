        <bounds x="60" y="240" width="220" height="55"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="el-do-wp0" archimateElement="el-wp0">
        <bounds x="320" y="240" width="240" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="el-conn-wp0-g2" source="el-do-wp0" target="el-do-g2" archimateRelationship="el-rel-wp0-g2"/>
