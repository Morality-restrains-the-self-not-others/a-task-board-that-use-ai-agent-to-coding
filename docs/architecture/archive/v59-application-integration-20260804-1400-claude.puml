' ═══════════════════════════════════════
' Relationships — v59 Data Flows
' ═══════════════════════════════════════

' Gateway routing (all Go, zero Django upstream)
Rel_Flow(gateway, taskAuth, "/api/auth/*, /api/accounts/*\n🟡 + /api/system-admin/roles/*\n🟡 + /api/auth/user/permissions")
Rel_Flow(gateway, taskGitOauth, "/api/accounts/*/oauth/*")
Rel_Flow(gateway, taskTenant, "/api/tenant/*/companies/*\n🟡 + /api/tenant/*/members/*/role")
Rel_Flow(gateway, taskProject, "/api/tenant/*/projects/*")
Rel_Flow(gateway, taskTask, "/api/tenant/*/todos/*, /api/tasks/*")
Rel_Flow(gateway, taskAIComment, "/api/tenant/*/ai-comments/*")
Rel_Flow(gateway, taskCloud, "/api/tenant/*/cloud/*, /api/system-admin/*")
Rel_Flow(gateway, taskBill, "/api/billing/*, /api/system-admin/resource-pricing/*")

' Gateway injects auth context
Rel_Flow(gateway, shareLibAuthz, "forward-auth → X-User-Roles, X-User-Permissions")

' Services consume permission middleware
Rel_Serving(shareLibAuthz, taskAuth, "platform role check")
Rel_Serving(shareLibAuthz, taskTenant, "tenant role check")
Rel_Serving(shareLibAuthz, taskCloud, "platform role check")
Rel_Serving(shareLibAuthz, taskBill, "platform role check")
Rel_Serving(shareLibAuthz, taskProject, "tenant role check")
Rel_Serving(shareLibAuthz, taskTask, "tenant role check")

' Kafka event consumers
Rel_Flow(kafkaBroker, kafkaConsumers, "consume domain events")
Rel_Flow(kafkaConsumers, taskTenant, "company/user events")
Rel_Flow(kafkaConsumers, taskAuth, "user profile events")
Rel_Flow(kafkaConsumers, taskProject, "workspace/deliverable events")
Rel_Flow(kafkaConsumers, taskCloud, "cloud/IAM/feature-params events")
Rel_Flow(kafkaConsumers, taskEvents, "SSE dispatch")

' Service data ownership
Rel_Access_w(taskAuth, taskAuthDB, "users, profiles, sessions\n🟡 + roles, permissions, user_roles")
Rel_Access_w(taskGitOauth, taskGitOauthDB, "git identities, OAuth tokens")
Rel_Access_w(taskTenant, taskTenantDB, "companies, members, groups\n🟡 + member_roles")
Rel_Access_w(taskProject, taskProjectDB, "projects, workspaces, ACL")
Rel_Access_w(taskTask, taskTaskDB, "todos, task fields")
Rel_Access_w(taskCloud, taskCloudDB, "platforms, VPCs, images, CSC")
Rel_Access_w(taskBill, taskBillDB, "billing, subscriptions, pricing")

' New domain events
Rel_Flow(taskAuth, evtRoleAssigned, "publish → Kafka")
Rel_Flow(taskAuth, evtRoleRevoked, "publish → Kafka")
Rel_Flow(taskTenant, evtTenantRole, "publish → Kafka")
Rel_Flow(evtRoleAssigned, kafkaBroker, "→ Domain Events Bus")
Rel_Flow(evtRoleRevoked, kafkaBroker, "→ Domain Events Bus")
Rel_Flow(evtTenantRole, kafkaBroker, "→ Domain Events Bus")

' Deprecated patterns
Rel_Flow(oldIsAdmin, taskTenant, "[DEPRECATED] is_admin==1 check")
Rel_Flow(oldIsSuperuser, taskAuth, "[DEPRECATED] is_superuser check")

