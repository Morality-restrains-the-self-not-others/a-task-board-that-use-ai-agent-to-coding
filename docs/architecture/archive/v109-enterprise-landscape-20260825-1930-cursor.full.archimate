    <element xsi:type="archimate:BusinessProcess" id="id-v109-el-detail" name="查看租户详情 [NEW v109]"/>
  </folder>
  <folder name="Application" id="id-v109el-app" type="application">
    <element xsi:type="archimate:ApplicationComponent" id="id-v109-el-fe" name="taskFE 系统管理 [MODIFIED v109]"/>
    <element xsi:type="archimate:ApplicationComponent" id="id-v109-el-tenant" name="taskTenantService [MODIFIED v109]"/>
    <element xsi:type="archimate:ApplicationComponent" id="id-v109-el-bill" name="taskBill [MODIFIED v109]"/>
    <element xsi:type="archimate:ApplicationComponent" id="id-v109-el-proj" name="taskProjectService [MODIFIED v109]"/>
  </folder>
  <folder name="Implementation &amp; Migration" id="id-v109el-im" type="implementation_migration">
