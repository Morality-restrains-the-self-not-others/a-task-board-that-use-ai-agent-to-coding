<?xml version="1.0" encoding="UTF-8"?>
<archimate:model
    xmlns="http://www.opengroup.org/xsd/archimate/3.0/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:archimate="http://www.archimatetool.com/archimate"
    xsi:schemaLocation="http://www.opengroup.org/xsd/archimate/3.0/ http://www.opengroup.org/xsd/archimate/3.1/archimate3_Diagram.xsd"
    identifier="model-v16-el-20260808-1732">

  <name xml:lang="en">daydaymoney Enterprise Landscape v16 Target</name>
  <purpose>浏览器插件固定 ID 改为管理员后台可配置 — auth_oidc_client 新增 managed_by 列 (bootstrap|admin, admin 行 seed INSERT-only 不覆盖管理员改库)；taskAuth system-admin 新增 GET/PUT /api/system-admin/oidc-extension/ (requireSuperuser)；taskFE SystemAdmin 新增「浏览器插件」管理页；taskGateway APISIX 新增路由</purpose>

  <folder name="Business" id="f-biz" type="business"/>
  <folder name="Application" id="f-app" type="application"/>
  <folder name="Technology" id="f-tech" type="technology"/>
  <folder name="Implementation" id="f-impl" type="implementation_migration"/>
  <folder name="Relations" id="f-rel" type="relations"/>

  <!-- Application Layer — v16 插件 OIDC 白名单管理相关组件 -->
  <element xsi:type="archimate:ApplicationComponent" name="API Gateway (APISIX :18081) [MODIFIED v16: +/api/system-admin/oidc-extension/* 路由]" id="gateway"/>
  <element xsi:type="archimate:ApplicationComponent" name="taskAuth (Go :8003) [MODIFIED v16: +GET/PUT /api/system-admin/oidc-extension/ +seed INSERT-only]" id="authSvc"/>
  <element xsi:type="archimate:ApplicationComponent" name="taskFE (Vue SPA) [MODIFIED v16: SystemAdmin「浏览器插件」管理页]" id="feSvc"/>
  <element xsi:type="archimate:ApplicationDataObject" name="taskAuth DB (+auth_oidc_client.managed_by 🆕)" id="authDB"/>

  <!-- Implementation & Migration — v16 架构变迁 -->
  <element xsi:type="archimate:Plateau" name="Plateau v15 — 任务帖存续期 (2026-08-07)" id="plateauV15"/>
  <element xsi:type="archimate:Plateau" name="Plateau v16 — 插件 OIDC 白名单管理 (2026-08-08)" id="plateauV16"/>
  <element xsi:type="archimate:Gap" name="Gap: 插件 ID 硬编码 conf + bootstrap 自愈覆盖管理员改库 → 不可运维" id="gapExt"/>
  <element xsi:type="archimate:WorkPackage" name="WP-oidc-extension-admin (P1 migration 031+seed 语义 → P2 taskAuth 管理端点 → P3 gateway 路由+FE 页 → P4 部署验证+OPT-024 联动)" id="wpExt"/>

  <!-- Relationships -->
  <element xsi:type="archimate:FlowRelationship" id="rel-fe-gw" source="feSvc" target="gateway"/>
  <element xsi:type="archimate:FlowRelationship" id="rel-gw-auth" source="gateway" target="authSvc"/>
  <element xsi:type="archimate:AccessRelationship" id="rel-auth-db" source="authSvc" target="authDB" accessType="write"/>
  <element xsi:type="archimate:TriggeringRelationship" id="rel-trigger" source="plateauV15" target="gapExt"/>
  <element xsi:type="archimate:RealizationRelationship" id="rel-wp-gap" source="wpExt" target="gapExt"/>
  <element xsi:type="archimate:RealizationRelationship" id="rel-wp-plat" source="wpExt" target="plateauV16"/>

  <folder name="Views" id="f-views" type="diagrams">
    <!-- 视图 1: 架构变迁 v15→v16 -->
    <element xsi:type="archimate:ArchiMateDiagramModel" name="架构变迁 v15→v16 — 插件 OIDC 白名单管理" id="view-migration">
      <child xsi:type="archimate:DiagramObject" id="do-plateauV15" archimateElement="plateauV15">
        <bounds x="48" y="120" width="220" height="50"/>
        <sourceConnection xsi:type="archimate:Connection" id="conn-v15-gap" source="do-plateauV15" target="do-gapExt" archimateRelationship="rel-trigger"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="do-gapExt" archimateElement="gapExt" targetConnections="conn-v15-gap conn-wp-gap">
        <bounds x="300" y="120" width="320" height="60"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="do-wpExt" archimateElement="wpExt">
        <bounds x="660" y="80" width="320" height="60"/>
        <sourceConnection xsi:type="archimate:Connection" id="conn-wp-gap" source="do-wpExt" target="do-gapExt" archimateRelationship="rel-wp-gap"/>
        <sourceConnection xsi:type="archimate:Connection" id="conn-wp-v16" source="do-wpExt" target="do-plateauV16" archimateRelationship="rel-wp-plat"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="do-plateauV16" archimateElement="plateauV16" targetConnections="conn-wp-v16">
        <bounds x="660" y="180" width="320" height="50"/>
      </child>
    </element>

    <!-- 视图 2: v16 Target — 插件 ID 白名单管理链 -->
    <element xsi:type="archimate:ArchiMateDiagramModel" name="v16 Target — 插件 ID 白名单管理链" id="view-topology">
      <child xsi:type="archimate:DiagramObject" id="do-feSvc" archimateElement="feSvc">
        <bounds x="40" y="60" width="200" height="60"/>
        <sourceConnection xsi:type="archimate:Connection" id="conn-fe-gw" source="do-feSvc" target="do-gateway" archimateRelationship="rel-fe-gw"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="do-gateway" archimateElement="gateway" targetConnections="conn-fe-gw">
        <bounds x="300" y="60" width="200" height="50"/>
        <sourceConnection xsi:type="archimate:Connection" id="conn-gw-auth" source="do-gateway" target="do-authSvc" archimateRelationship="rel-gw-auth"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="do-authSvc" archimateElement="authSvc" targetConnections="conn-gw-auth">
        <bounds x="560" y="60" width="220" height="60"/>
        <sourceConnection xsi:type="archimate:Connection" id="conn-auth-db" source="do-authSvc" target="do-authDB" archimateRelationship="rel-auth-db"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="do-authDB" archimateElement="authDB" targetConnections="conn-auth-db">
        <bounds x="560" y="180" width="220" height="60"/>
      </child>
    </element>
  </folder>
</archimate:model>