        <bounds x="48" y="48" width="140" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v82-conn-pl80-gap" source="id-v82-do-pl80" target="id-v82-do-gap" archimateRelationship="id-v82-rel-pl80-gap"/>
      </child>
