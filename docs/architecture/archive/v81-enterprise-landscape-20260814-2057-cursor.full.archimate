        <sourceConnection xsi:type="archimate:Connection" id="id-v81elsf-c-wp-pl81" source="id-v81elsf-do-wp" target="id-v81elsf-do-pl81" archimateRelationship="id-v81elsf-rel-wp-pl81"/>
