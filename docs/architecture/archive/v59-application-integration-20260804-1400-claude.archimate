<?xml version="1.0" encoding="UTF-8"?>
<archimate:model
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:archimate="http://www.archimatetool.com/archimate"
    xsi:schemaLocation="http://www.archimatetool.com/archimate http://www.archimatetool.com/archimate"
    identifier="model-v59-rbac-20260804">

  <name xml:lang="en">v59 Identity Role Permission System — RBAC Architecture</name>
  <purpose>v59 target architecture: two-level four-role RBAC permission system with cross-tenant isolation. Extends taskAuth (platform roles: super_admin/employee) + taskTenantService (tenant roles: tenant_admin/member) + new shareLib/authz middleware. Includes Implementation &amp; Migration view (v57→v59).</purpose>

  <!-- ══════════════════════════════════════════════════════════ -->
  <!-- FOLDER: Application Layer -->
  <!-- ══════════════════════════════════════════════════════════ -->
  <folder name="Application" id="folder-app" type="application">
    <element xsi:type="archimate:ApplicationComponent" name="taskAuth (:8003) [MODIFIED v59]" id="taskAuth"/>
    <element xsi:type="archimate:ApplicationComponent" name="taskGitOauth (:8002)" id="taskGitOauth"/>
    <element xsi:type="archimate:ApplicationComponent" name="taskTenantService (:8020) [MODIFIED v59]" id="taskTenant"/>
    <element xsi:type="archimate:ApplicationComponent" name="taskProjectService (:8016)" id="taskProject"/>
    <element xsi:type="archimate:ApplicationComponent" name="taskTaskService (:8021)" id="taskTask"/>
    <element xsi:type="archimate:ApplicationComponent" name="taskAIComment (:8022)" id="taskAIComment"/>
    <element xsi:type="archimate:ApplicationComponent" name="taskCloudService (:8018)" id="taskCloud"/>
    <element xsi:type="archimate:ApplicationComponent" name="taskBill (:8004)" id="taskBill"/>
    <element xsi:type="archimate:ApplicationComponent" name="taskEvents (:8023)" id="taskEvents"/>
    <element xsi:type="archimate:ApplicationComponent" name="shareLib/authz Permission Middleware [NEW v59]" id="shareLibAuthz"/>
    <element xsi:type="archimate:ApplicationComponent" name="Kafka Consumers (Go)" id="kafkaConsumers"/>
    <element xsi:type="archimate:ApplicationComponent" name="APISIX Gateway (:18081) [MODIFIED v59]" id="gateway"/>
    <element xsi:type="archimate:DataObject" name="Kafka Domain Events Bus" id="kafkaBroker"/>
    <element xsi:type="archimate:DataObject" name="taskAuth DB [MODIFIED v59]" id="taskAuthDB"/>
    <element xsi:type="archimate:DataObject" name="taskGitOauth DB" id="taskGitOauthDB"/>
    <element xsi:type="archimate:DataObject" name="taskTenant DB [MODIFIED v59]" id="taskTenantDB"/>
    <element xsi:type="archimate:DataObject" name="taskProject DB" id="taskProjectDB"/>
    <element xsi:type="archimate:DataObject" name="taskTask DB" id="taskTaskDB"/>
    <element xsi:type="archimate:DataObject" name="taskCloud DB" id="taskCloudDB"/>
    <element xsi:type="archimate:DataObject" name="taskBill DB" id="taskBillDB"/>
    <element xsi:type="archimate:ApplicationEvent" name="PlatformRoleAssigned [NEW v59]" id="evtRoleAssigned"/>
    <element xsi:type="archimate:ApplicationEvent" name="PlatformRoleRevoked [NEW v59]" id="evtRoleRevoked"/>
    <element xsi:type="archimate:ApplicationEvent" name="TenantRoleChanged [NEW v59]" id="evtTenantRole"/>
    <element xsi:type="archimate:ApplicationComponent" name="is_admin direct check [DEPRECATED v59]" id="oldIsAdmin"/>
    <element xsi:type="archimate:ApplicationComponent" name="is_superuser direct check [DEPRECATED v59]" id="oldIsSuperuser"/>
  </folder>

  <!-- ══════════════════════════════════════════════════════════ -->
  <!-- FOLDER: Implementation & Migration -->
  <!-- ══════════════════════════════════════════════════════════ -->
  <folder name="Implementation" id="folder-impl" type="implementation_migration">
    <element xsi:type="archimate:Plateau" name="Plateau v57 — Django退役 纯Go微服务 二元is_admin/is_superuser鉴权" id="plateauV57"/>
    <element xsi:type="archimate:Plateau" name="Plateau v59 — RBAC两级四角色权限体系 + 租户隔离 + shareLib/authz中间件" id="plateauV59"/>
    <element xsi:type="archimate:Gap" name="Gap: 缺分层角色体系、缺细粒度权限、缺租户隔离强制点、缺权限审计追踪" id="gapRoles"/>
    <element xsi:type="archimate:WorkPackage" name="WP Phase1: 数据模型(auth_role/auth_permission/auth_user_role/tenant_member_role) + API + shareLib/authz中间件 + 数据迁移" id="wpPhase1"/>
    <element xsi:type="archimate:WorkPackage" name="WP Phase2: 细粒度权限码 + 租户自定义角色 + 权限审计日志UI" id="wpPhase2"/>
  </folder>

  <!-- ══════════════════════════════════════════════════════════ -->
  <!-- FOLDER: Relations -->
  <!-- ══════════════════════════════════════════════════════════ -->
  <folder name="Relations" id="folder-rels" type="relations">
    <!-- Gateway routing -->
    <element xsi:type="archimate:FlowRelationship" name="" id="rel-gw-auth" source="gateway" target="taskAuth"/>
    <element xsi:type="archimate:FlowRelationship" name="" id="rel-gw-tenant" source="gateway" target="taskTenant"/>
    <element xsi:type="archimate:FlowRelationship" name="" id="rel-gw-project" source="gateway" target="taskProject"/>
    <element xsi:type="archimate:FlowRelationship" name="" id="rel-gw-task" source="gateway" target="taskTask"/>
    <element xsi:type="archimate:FlowRelationship" name="" id="rel-gw-cloud" source="gateway" target="taskCloud"/>
    <element xsi:type="archimate:FlowRelationship" name="" id="rel-gw-bill" source="gateway" target="taskBill"/>
    <element xsi:type="archimate:FlowRelationship" name="forward-auth roles" id="rel-gw-authz" source="gateway" target="shareLibAuthz"/>
    <!-- Permission middleware → services -->
    <element xsi:type="archimate:ServingRelationship" name="platform role check" id="rel-authz-auth" source="shareLibAuthz" target="taskAuth"/>
    <element xsi:type="archimate:ServingRelationship" name="tenant role check" id="rel-authz-tenant" source="shareLibAuthz" target="taskTenant"/>
    <element xsi:type="archimate:ServingRelationship" name="platform role check" id="rel-authz-cloud" source="shareLibAuthz" target="taskCloud"/>
    <element xsi:type="archimate:ServingRelationship" name="platform role check" id="rel-authz-bill" source="shareLibAuthz" target="taskBill"/>
    <element xsi:type="archimate:ServingRelationship" name="tenant role check" id="rel-authz-project" source="shareLibAuthz" target="taskProject"/>
    <element xsi:type="archimate:ServingRelationship" name="tenant role check" id="rel-authz-task" source="shareLibAuthz" target="taskTask"/>
    <!-- Kafka event flow -->
    <element xsi:type="archimate:FlowRelationship" name="consume" id="rel-kafka-consumers" source="kafkaBroker" target="kafkaConsumers"/>
    <element xsi:type="archimate:FlowRelationship" name="" id="rel-consumers-tenant" source="kafkaConsumers" target="taskTenant"/>
    <element xsi:type="archimate:FlowRelationship" name="" id="rel-consumers-auth" source="kafkaConsumers" target="taskAuth"/>
    <element xsi:type="archimate:FlowRelationship" name="" id="rel-consumers-project" source="kafkaConsumers" target="taskProject"/>
    <element xsi:type="archimate:FlowRelationship" name="" id="rel-consumers-cloud" source="kafkaConsumers" target="taskCloud"/>
    <element xsi:type="archimate:FlowRelationship" name="" id="rel-consumers-events" source="kafkaConsumers" target="taskEvents"/>
    <!-- Data ownership (Access) -->
    <element xsi:type="archimate:AccessRelationship" name="write" id="rel-auth-db" source="taskAuth" target="taskAuthDB"/>
    <element xsi:type="archimate:AccessRelationship" name="write" id="rel-tenant-db" source="taskTenant" target="taskTenantDB"/>
    <element xsi:type="archimate:AccessRelationship" name="write" id="rel-project-db" source="taskProject" target="taskProjectDB"/>
    <element xsi:type="archimate:AccessRelationship" name="write" id="rel-task-db" source="taskTask" target="taskTaskDB"/>
    <element xsi:type="archimate:AccessRelationship" name="write" id="rel-cloud-db" source="taskCloud" target="taskCloudDB"/>
    <element xsi:type="archimate:AccessRelationship" name="write" id="rel-bill-db" source="taskBill" target="taskBillDB"/>
    <!-- New domain events -->
    <element xsi:type="archimate:FlowRelationship" name="publish" id="rel-auth-ev1" source="taskAuth" target="evtRoleAssigned"/>
    <element xsi:type="archimate:FlowRelationship" name="publish" id="rel-auth-ev2" source="taskAuth" target="evtRoleRevoked"/>
    <element xsi:type="archimate:FlowRelationship" name="publish" id="rel-tenant-ev3" source="taskTenant" target="evtTenantRole"/>
    <element xsi:type="archimate:FlowRelationship" name="to bus" id="rel-ev1-kafka" source="evtRoleAssigned" target="kafkaBroker"/>
    <element xsi:type="archimate:FlowRelationship" name="to bus" id="rel-ev2-kafka" source="evtRoleRevoked" target="kafkaBroker"/>
    <element xsi:type="archimate:FlowRelationship" name="to bus" id="rel-ev3-kafka" source="evtTenantRole" target="kafkaBroker"/>
    <!-- Migration: Plateau → Gap → WorkPackage → Plateau -->
    <element xsi:type="archimate:AssociationRelationship" name="triggers" id="rel-plateauV57-gap" source="plateauV57" target="gapRoles"/>
    <element xsi:type="archimate:RealizationRelationship" name="closes" id="rel-wp1-gap" source="wpPhase1" target="gapRoles"/>
    <element xsi:type="archimate:RealizationRelationship" name="closes" id="rel-wp2-gap" source="wpPhase2" target="gapRoles"/>
    <element xsi:type="archimate:RealizationRelationship" name="delivers" id="rel-wp1-plateauV59" source="wpPhase1" target="plateauV59"/>
    <element xsi:type="archimate:RealizationRelationship" name="delivers" id="rel-wp2-plateauV59" source="wpPhase2" target="plateauV59"/>
  </folder>

  <!-- ══════════════════════════════════════════════════════════ -->
  <!-- FOLDER: Views -->
  <!-- ══════════════════════════════════════════════════════════ -->
  <folder name="Views" id="folder-views" type="diagrams">

    <!-- ══════════════════════════════════════════════════════ -->
    <!-- VIEW 1: 架构变迁 v57→v59 — 身份角色权限体系 -->
    <!-- ══════════════════════════════════════════════════════ -->
    <element xsi:type="archimate:ArchimateDiagramModel" name="架构变迁 v57→v59 — 身份角色权限体系" id="view-migration">
      <documentation>Implementation &amp; Migration: Plateau v57 → Gap → WorkPackages → Plateau v59</documentation>

      <!-- Plateau v57 -->
      <child xsi:type="archimate:DiagramObject" id="do-plateauV57" archimateElement="plateauV57">
        <bounds x="50" y="100" width="220" height="80"/>
        <sourceConnection xsi:type="archimate:Connection" id="conn-v57-gap"
          source="do-plateauV57" target="do-gap"
          archimateRelationship="rel-plateauV57-gap"/>
      </child>

      <!-- Gap -->
      <child xsi:type="archimate:DiagramObject" id="do-gap" archimateElement="gapRoles"
        targetConnections="conn-v57-gap conn-wp1-gap conn-wp2-gap">
        <bounds x="350" y="100" width="280" height="80"/>
      </child>

      <!-- WP Phase 1 -->
      <child xsi:type="archimate:DiagramObject" id="do-wp1" archimateElement="wpPhase1"
        targetConnections="conn-wp1-plateau">
        <bounds x="50" y="250" width="280" height="65"/>
        <sourceConnection xsi:type="archimate:Connection" id="conn-wp1-gap"
          source="do-wp1" target="do-gap"
          archimateRelationship="rel-wp1-gap"/>
        <sourceConnection xsi:type="archimate:Connection" id="conn-wp1-plateau"
          source="do-wp1" target="do-plateauV59"
          archimateRelationship="rel-wp1-plateauV59"/>
      </child>

      <!-- WP Phase 2 -->
      <child xsi:type="archimate:DiagramObject" id="do-wp2" archimateElement="wpPhase2"
        targetConnections="conn-wp2-plateau">
        <bounds x="50" y="350" width="280" height="65"/>
        <sourceConnection xsi:type="archimate:Connection" id="conn-wp2-gap"
          source="do-wp2" target="do-gap"
          archimateRelationship="rel-wp2-gap"/>
        <sourceConnection xsi:type="archimate:Connection" id="conn-wp2-plateau"
          source="do-wp2" target="do-plateauV59"
          archimateRelationship="rel-wp2-plateauV59"/>
      </child>

      <!-- Plateau v59 -->
      <child xsi:type="archimate:DiagramObject" id="do-plateauV59" archimateElement="plateauV59"
        targetConnections="conn-wp1-plateau conn-wp2-plateau">
        <bounds x="350" y="280" width="280" height="80"/>
      </child>
    </element>

    <!-- ══════════════════════════════════════════════════════ -->
