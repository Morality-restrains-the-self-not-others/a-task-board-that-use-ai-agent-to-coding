  <name xml:lang="en">AI Dev Platform — Application Integration v16 Target</name>
  <documentation>多入口同源 API：Edge nginx 分流；Vue API_BASE_URL 默认同源；Vite /api 代理；废弃 HTTPS→HTTP 绝对 gateway</documentation>

  <folder name="Application" id="id-v16-f-app" type="application">
    <element xsi:type="archimate:ApplicationComponent" name="Browser" id="id-v16-browser"/>
    <element xsi:type="archimate:ApplicationComponent" name="🟡 Vue Frontend [MODIFIED v16]" id="id-v16-vue"/>
