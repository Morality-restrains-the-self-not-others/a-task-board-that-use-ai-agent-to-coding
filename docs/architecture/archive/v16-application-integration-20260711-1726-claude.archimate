    <element xsi:type="archimate:ApplicationComponent" name="saas-backend Django :8001" id="id-v16-be"/>
    <element xsi:type="archimate:ApplicationComponent" name="🔴 绝对 http://IP:18081 API 基址 [DEPRECATED v16]" id="id-v16-abs-api"/>
  </folder>

  <folder name="Technology" id="id-v16-f-tech" type="technology">
    <element xsi:type="archimate:Node" name="🟢 Edge nginx (daydaymoney / IP / …) [NEW v16]" id="id-v16-edge"/>
    <element xsi:type="archimate:Node" name="🟡 Vite :4000 + /api proxy [MODIFIED v16]" id="id-v16-vite"/>
