<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="application-integration v101 变迁 (v100→v101)" id="id-v101aidiff01">
  <folder name="Application" id="id-v101aid-app" type="application">
    <element xsi:type="archimate:ApplicationComponent" id="id-v101-app-runall" name="runAll Status UI :9999 [MODIFIED v101]"/>
    <element xsi:type="archimate:ApplicationComponent" id="id-v101-app-svc" name="托管业务服务 [MODIFIED v101]"/>
  </folder>
  <folder name="Technology" id="id-v101aid-tech" type="technology">
    <element xsi:type="archimate:Node" id="id-v101-tech-kernel" name="Linux session/pgid [NEW v101]"/>
  </folder>
  <folder name="Implementation &amp; Migration" id="id-v101aid-im" type="implementation_migration">
    <element xsi:type="archimate:Plateau" id="id-v101-pl-v100" name="Plateau v100"/>
    <element xsi:type="archimate:Plateau" id="id-v101-pl-v101" name="Plateau v101"/>
    <element xsi:type="archimate:Gap" id="id-v101-gap" name="Gap: runAll 退出级联停栈"/>
    <element xsi:type="archimate:WorkPackage" id="id-v101-wp" name="WP-runall-orchestrator-independence"/>
  </folder>
  <folder name="Relations" id="id-v101aid-rel" type="relations">
    <element xsi:type="archimate:ServingRelationship" id="id-v101-rel-ra-svc" source="id-v101-app-runall" target="id-v101-app-svc" name="start/stop/adopt"/>
    <element xsi:type="archimate:FlowRelationship" id="id-v101-rel-ra-stop" source="id-v101-app-runall" target="id-v101-app-svc" name="显式 stop-all 才 SIGTERM"/>
    <element xsi:type="archimate:ServingRelationship" id="id-v101-rel-kern-svc" source="id-v101-tech-kernel" target="id-v101-app-svc" name="独立 sid"/>
    <element xsi:type="archimate:AssociationRelationship" id="id-v101-rel-pl100-gap" source="id-v101-pl-v100" target="id-v101-gap"/>
    <element xsi:type="archimate:RealizationRelationship" id="id-v101-rel-wp-gap" source="id-v101-wp" target="id-v101-gap"/>
    <element xsi:type="archimate:AssociationRelationship" id="id-v101-rel-wp-pl101" source="id-v101-wp" target="id-v101-pl-v101"/>
  </folder>
  <folder name="Views" id="id-v101aid-views" type="diagrams">
    <element xsi:type="archimate:ArchimateDiagramModel" id="id-v101-view-mig" name="架构变迁 v100→v101 — runall-orchestrator-independence">
      <child xsi:type="archimate:DiagramObject" id="id-v101-do-pl100" archimateElement="id-v101-pl-v100">
        <bounds x="48" y="48" width="140" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v101-c-pl100-gap" source="id-v101-do-pl100" target="id-v101-do-gap" archimateRelationship="id-v101-rel-pl100-gap"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v101-do-gap" targetConnections="id-v101-c-pl100-gap id-v101-c-wp-gap" archimateElement="id-v101-gap">
        <bounds x="240" y="48" width="360" height="55"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v101-do-wp" archimateElement="id-v101-wp">
        <bounds x="240" y="160" width="360" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v101-c-wp-gap" source="id-v101-do-wp" target="id-v101-do-gap" archimateRelationship="id-v101-rel-wp-gap"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v101-c-wp-pl101" source="id-v101-do-wp" target="id-v101-do-pl101" archimateRelationship="id-v101-rel-wp-pl101"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v101-do-pl101" targetConnections="id-v101-c-wp-pl101" archimateElement="id-v101-pl-v101">
        <bounds x="640" y="160" width="140" height="55"/>
      </child>
    </element>
    <element xsi:type="archimate:ArchimateDiagramModel" id="id-v101-view-flow" name="v101 Target — 编排器不拆栈">
      <child xsi:type="archimate:DiagramObject" id="id-v101-d-ra" archimateElement="id-v101-app-runall">
        <bounds x="48" y="48" width="220" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v101-c-ra-svc" source="id-v101-d-ra" target="id-v101-d-svc" archimateRelationship="id-v101-rel-ra-svc"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v101-c-ra-stop" source="id-v101-d-ra" target="id-v101-d-svc" archimateRelationship="id-v101-rel-ra-stop"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v101-d-svc" targetConnections="id-v101-c-ra-svc id-v101-c-ra-stop id-v101-c-kern-svc" archimateElement="id-v101-app-svc">
        <bounds x="320" y="48" width="200" height="55"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v101-d-kern" archimateElement="id-v101-tech-kernel">
        <bounds x="320" y="160" width="200" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v101-c-kern-svc" source="id-v101-d-kern" target="id-v101-d-svc" archimateRelationship="id-v101-rel-kern-svc"/>
      </child>
    </element>
  </folder>
</archimate:model>
