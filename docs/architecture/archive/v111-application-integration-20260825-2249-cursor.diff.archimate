<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="application-integration v111 变迁 (v110→v111)" id="id-v111aidiff01">
  <folder name="Application" id="id-v111ai-app" type="application">
    <element xsi:type="archimate:ApplicationComponent" id="id-v111-app-fe" name="taskFE SPA [MODIFIED v111]"/>
    <element xsi:type="archimate:ApplicationComponent" id="id-v111-app-gw" name="taskGateway / APISIX [MODIFIED v111]"/>
    <element xsi:type="archimate:ApplicationComponent" id="id-v111-app-auth" name="taskAuth [MODIFIED v111]"/>
    <element xsi:type="archimate:DataObject" id="id-v111-data-hist" name="auth_login_history [NEW v111]"/>
  </folder>
  <folder name="Business" id="id-v111ai-biz" type="business">
    <element xsi:type="archimate:BusinessEvent" id="id-v111-ev-login" name="USER_LOGGED_IN [MODIFIED v111]"/>
  </folder>
  <folder name="Implementation &amp; Migration" id="id-v111ai-im" type="implementation_migration">
    <element xsi:type="archimate:Plateau" id="id-v111-pl-v110" name="Plateau v110"/>
    <element xsi:type="archimate:Plateau" id="id-v111-pl-v111" name="Plateau v111 登录历史"/>
    <element xsi:type="archimate:Gap" id="id-v111-gap" name="Gap: 仅 last_login，无 IP/入口历史"/>
    <element xsi:type="archimate:WorkPackage" id="id-v111-wp" name="WP-login-history"/>
  </folder>
  <folder name="Relations" id="id-v111ai-rel" type="relations">
    <element xsi:type="archimate:FlowRelationship" id="id-v111-rel-fe-gw" source="id-v111-app-fe" target="id-v111-app-gw" name="查看登录历史"/>
    <element xsi:type="archimate:FlowRelationship" id="id-v111-rel-gw-auth" source="id-v111-app-gw" target="id-v111-app-auth" name="login-history GET"/>
    <element xsi:type="archimate:AccessRelationship" id="id-v111-rel-auth-hist" source="id-v111-app-auth" target="id-v111-data-hist" name="write on login / read on list"/>
    <element xsi:type="archimate:FlowRelationship" id="id-v111-rel-auth-ev" source="id-v111-app-auth" target="id-v111-ev-login" name="发布"/>
    <element xsi:type="archimate:TriggeringRelationship" id="id-v111-rel-pl110-gap" source="id-v111-pl-v110" target="id-v111-gap" name="identifies"/>
    <element xsi:type="archimate:RealizationRelationship" id="id-v111-rel-wp-gap" source="id-v111-wp" target="id-v111-gap"/>
    <element xsi:type="archimate:RealizationRelationship" id="id-v111-rel-wp-pl111" source="id-v111-wp" target="id-v111-pl-v111"/>
  </folder>
  <folder name="Views" id="id-v111ai-views" type="diagrams">
    <element xsi:type="archimate:ArchimateDiagramModel" id="id-v111-view-mig" name="架构变迁 v110→v111 — login-history">
      <child xsi:type="archimate:DiagramObject" id="id-v111-do-pl110" archimateElement="id-v111-pl-v110">
        <bounds x="48" y="48" width="140" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v111-c-pl110-gap" source="id-v111-do-pl110" target="id-v111-do-gap" archimateRelationship="id-v111-rel-pl110-gap"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v111-do-gap" targetConnections="id-v111-c-pl110-gap id-v111-c-wp-gap" archimateElement="id-v111-gap">
        <bounds x="240" y="48" width="400" height="55"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v111-do-wp" archimateElement="id-v111-wp">
        <bounds x="240" y="160" width="400" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v111-c-wp-gap" source="id-v111-do-wp" target="id-v111-do-gap" archimateRelationship="id-v111-rel-wp-gap"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v111-c-wp-pl111" source="id-v111-do-wp" target="id-v111-do-pl111" archimateRelationship="id-v111-rel-wp-pl111"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v111-do-pl111" targetConnections="id-v111-c-wp-pl111" archimateElement="id-v111-pl-v111">
        <bounds x="680" y="160" width="280" height="55"/>
      </child>
    </element>
    <element xsi:type="archimate:ArchimateDiagramModel" id="id-v111-view-topo" name="v111 Target — 登录历史">
      <child xsi:type="archimate:DiagramObject" id="id-v111-do-fe" archimateElement="id-v111-app-fe">
        <bounds x="48" y="96" width="160" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v111-c-fe-gw" source="id-v111-do-fe" target="id-v111-do-gw" archimateRelationship="id-v111-rel-fe-gw"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v111-do-gw" targetConnections="id-v111-c-fe-gw" archimateElement="id-v111-app-gw">
        <bounds x="280" y="96" width="180" height="60"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v111-c-gw-auth" source="id-v111-do-gw" target="id-v111-do-auth" archimateRelationship="id-v111-rel-gw-auth"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v111-do-auth" targetConnections="id-v111-c-gw-auth" archimateElement="id-v111-app-auth">
        <bounds x="520" y="96" width="160" height="60"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v111-c-auth-hist" source="id-v111-do-auth" target="id-v111-do-hist" archimateRelationship="id-v111-rel-auth-hist"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v111-c-auth-ev" source="id-v111-do-auth" target="id-v111-do-ev" archimateRelationship="id-v111-rel-auth-ev"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v111-do-hist" targetConnections="id-v111-c-auth-hist" archimateElement="id-v111-data-hist">
        <bounds x="740" y="48" width="220" height="50"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v111-do-ev" targetConnections="id-v111-c-auth-ev" archimateElement="id-v111-ev-login">
        <bounds x="740" y="160" width="220" height="50"/>
      </child>
    </element>
  </folder>
</archimate:model>
