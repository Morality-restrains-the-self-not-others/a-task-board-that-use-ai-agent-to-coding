<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="enterprise-landscape v90 变迁 (v88→v90)" id="id-v90eldiff01">
  <folder name="Business" id="id-v90eld-biz" type="business">
    <element xsi:type="archimate:BusinessActor" id="id-v90el-vendor" name="镜像厂商"/>
    <element xsi:type="archimate:BusinessProcess" id="id-v90el-publish" name="登记容器镜像"/>
  </folder>
  <folder name="Application" id="id-v90eld-app" type="application">
    <element xsi:type="archimate:ApplicationComponent" id="id-v90el-aip" name="taskAiProvider [MODIFIED v90]"/>
    <element xsi:type="archimate:DataObject" id="id-v90el-img" name="vendorcontainerimage + skill version [MODIFIED v90]"/>
  </folder>
  <folder name="Motivation" id="id-v90eld-mot" type="motivation">
    <element xsi:type="archimate:Constraint" id="id-v90el-c1" name="镜像必须声明已发布契约版本"/>
    <element xsi:type="archimate:Principle" id="id-v90el-p1" name="单活 HTTP 面；版本是标签不是 URL 分叉"/>
  </folder>
  <folder name="Implementation &amp; Migration" id="id-v90eld-im" type="implementation_migration">
    <element xsi:type="archimate:Plateau" id="id-v90el-pl88" name="Plateau v88"/>
    <element xsi:type="archimate:Plateau" id="id-v90el-pl90" name="Plateau v90"/>
    <element xsi:type="archimate:Gap" id="id-v90el-gap" name="Gap: skill 无版本"/>
    <element xsi:type="archimate:WorkPackage" id="id-v90el-wp" name="WP-saas-inbound-skill-version"/>
  </folder>
  <folder name="Relations" id="id-v90eld-rel" type="relations">
    <element xsi:type="archimate:TriggeringRelationship" id="id-v90el-rel-v-p" source="id-v90el-vendor" target="id-v90el-publish" name="添加镜像版本"/>
    <element xsi:type="archimate:FlowRelationship" id="id-v90el-rel-p-aip" source="id-v90el-publish" target="id-v90el-aip" name="saas_inbound_skill_version"/>
    <element xsi:type="archimate:AccessRelationship" id="id-v90el-rel-aip-img" source="id-v90el-aip" target="id-v90el-img" name="W"/>
    <element xsi:type="archimate:AssociationRelationship" id="id-v90el-rel-img-c" source="id-v90el-img" target="id-v90el-c1"/>
    <element xsi:type="archimate:AssociationRelationship" id="id-v90el-rel-aip-p" source="id-v90el-aip" target="id-v90el-p1"/>
    <element xsi:type="archimate:AssociationRelationship" id="id-v90el-rel-pl88-gap" source="id-v90el-pl88" target="id-v90el-gap"/>
    <element xsi:type="archimate:RealizationRelationship" id="id-v90el-rel-wp-gap" source="id-v90el-wp" target="id-v90el-gap"/>
    <element xsi:type="archimate:RealizationRelationship" id="id-v90el-rel-wp-pl90" source="id-v90el-wp" target="id-v90el-pl90"/>
  </folder>
  <folder name="Views" id="id-v90eld-views" type="diagrams">
    <element xsi:type="archimate:ArchimateDiagramModel" id="id-v90el-view-mig" name="架构变迁 v88→v90 — saas-inbound-skill-version">
      <child xsi:type="archimate:DiagramObject" id="id-v90el-d-pl88" archimateElement="id-v90el-pl88">
        <bounds x="48" y="48" width="140" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v90el-c-pl88-gap" source="id-v90el-d-pl88" target="id-v90el-d-gap" archimateRelationship="id-v90el-rel-pl88-gap"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v90el-d-gap" targetConnections="id-v90el-c-pl88-gap id-v90el-c-wp-gap" archimateElement="id-v90el-gap">
        <bounds x="240" y="48" width="280" height="55"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v90el-d-wp" archimateElement="id-v90el-wp">
        <bounds x="240" y="160" width="280" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v90el-c-wp-gap" source="id-v90el-d-wp" target="id-v90el-d-gap" archimateRelationship="id-v90el-rel-wp-gap"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v90el-c-wp-pl90" source="id-v90el-d-wp" target="id-v90el-d-pl90" archimateRelationship="id-v90el-rel-wp-pl90"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v90el-d-pl90" targetConnections="id-v90el-c-wp-pl90" archimateElement="id-v90el-pl90">
        <bounds x="560" y="160" width="140" height="55"/>
      </child>
    </element>
    <element xsi:type="archimate:ArchimateDiagramModel" id="id-v90el-view-biz" name="v90 Target — 厂商登记镜像选契约版本">
      <child xsi:type="archimate:DiagramObject" id="id-v90el-d-vendor" archimateElement="id-v90el-vendor">
        <bounds x="48" y="48" width="140" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v90el-c-v-p" source="id-v90el-d-vendor" target="id-v90el-d-pub" archimateRelationship="id-v90el-rel-v-p"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v90el-d-pub" targetConnections="id-v90el-c-v-p" archimateElement="id-v90el-publish">
        <bounds x="240" y="48" width="160" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v90el-c-p-aip" source="id-v90el-d-pub" target="id-v90el-d-aip" archimateRelationship="id-v90el-rel-p-aip"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v90el-d-aip" targetConnections="id-v90el-c-p-aip" archimateElement="id-v90el-aip">
        <bounds x="460" y="48" width="180" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v90el-c-aip-img" source="id-v90el-d-aip" target="id-v90el-d-img" archimateRelationship="id-v90el-rel-aip-img"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v90el-c-aip-p1" source="id-v90el-d-aip" target="id-v90el-d-p1" archimateRelationship="id-v90el-rel-aip-p"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v90el-d-img" targetConnections="id-v90el-c-aip-img" archimateElement="id-v90el-img">
        <bounds x="460" y="140" width="280" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v90el-c-img-c" source="id-v90el-d-img" target="id-v90el-d-c1" archimateRelationship="id-v90el-rel-img-c"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v90el-d-c1" targetConnections="id-v90el-c-img-c" archimateElement="id-v90el-c1">
        <bounds x="48" y="140" width="280" height="55"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v90el-d-p1" targetConnections="id-v90el-c-aip-p1" archimateElement="id-v90el-p1">
        <bounds x="48" y="220" width="360" height="55"/>
      </child>
    </element>
  </folder>
</archimate:model>
