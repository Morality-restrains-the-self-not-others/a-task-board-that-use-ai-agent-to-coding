' ═══ Relationships ═══

' Gateway → PDP
Rel_Flow(gateway, taskAuth, "forward-auth\n→ /api/internal/authz/check\n← X-User-Roles, X-Tenant-Perms")

' Gateway → Services
Rel_Flow(gateway, taskTenant, "/api/tenant/*")
Rel_Flow(gateway, taskProject, "/api/tenant/*/projects/*")
Rel_Flow(gateway, taskTask, "/api/tenant/*/todos/*")
Rel_Flow(gateway, taskAIComment, "/api/tenant/*/ai-comments/*")
Rel_Flow(gateway, taskCloud, "/api/system-admin/*\n/api/tenant/*/cloud/*")
Rel_Flow(gateway, taskBill, "/api/billing/*\n/api/system-admin/*")
Rel_Flow(gateway, taskFE, "SPA 静态资源")

' authz thin client → services
Rel_Serving(shareLibAuthz, taskAuth, "CheckPerm() HTTP fallback")
Rel_Serving(shareLibAuthz, taskTenant, "RequirePerm(member:*)\nRequireGroupAdmin")
Rel_Serving(shareLibAuthz, taskCloud, "RequirePerm(cloud:*)\n+组资源继承")
Rel_Serving(shareLibAuthz, taskBill, "RequirePerm(billing:*)")
Rel_Serving(shareLibAuthz, taskProject, "RequirePerm(project:*)\n+组资源继承")
Rel_Serving(shareLibAuthz, taskTask, "RequirePerm(task:*)\n+组资源继承")

' Kafka
