  <name xml:lang="en">daydaymoney Enterprise Landscape v12 Current</name>
  <purpose>基线回填 v11（2026-07-07）之后的结构性变化 — 全量 Go 微服务拓扑、Django saas-backend 完全退役、RBAC 集中授权（PDP + shareLib/authz）、微信身份统一</purpose>

  <folder name="Business" id="f-biz" type="business"/>
  <folder name="Application" id="f-app" type="application"/>
