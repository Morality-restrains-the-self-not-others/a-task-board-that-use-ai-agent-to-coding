  <element xsi:type="archimate:ApplicationComponent" name="taskGitOauth Go (:8002) [NEW v12]" id="gitOauthSvc"/>
  <element xsi:type="archimate:ApplicationComponent" name="🟢 taskSSE Go (:8007) [NEW v12]" id="sseSvc"/>
