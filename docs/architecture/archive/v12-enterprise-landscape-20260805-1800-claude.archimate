  <folder name="Views" id="f-views" type="diagrams">
    <element xsi:type="archimate:ArchiMateDiagramModel" name="架构变迁 v11→v12 — 基线回填" id="view-migration">
      <child xsi:type="archimate:DiagramObject" id="do-platV11" archimateElement="platV11">
        <bounds x="48" y="120" width="220" height="50"/>
        <sourceConnection xsi:type="archimate:Connection" id="conn-v11-gap" source="do-platV11" target="do-gapBaseline" archimateRelationship="rel24"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="do-gapBaseline" archimateElement="gapBaseline" targetConnections="conn-v11-gap conn-wp-gap">
        <bounds x="300" y="120" width="280" height="50"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="do-wpV12" archimateElement="wpV12">
        <bounds x="620" y="80" width="280" height="50"/>
        <sourceConnection xsi:type="archimate:Connection" id="conn-wp-gap" source="do-wpV12" target="do-gapBaseline" archimateRelationship="rel25"/>
