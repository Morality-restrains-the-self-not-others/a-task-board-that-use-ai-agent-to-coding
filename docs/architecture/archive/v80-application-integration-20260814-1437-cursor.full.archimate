<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="application-integration v80 全量 (post-change)" id="id-v80full01">
  <folder name="Application" id="id-v80full-app" type="application">
    <element xsi:type="archimate:ApplicationComponent" id="id-v80f-app-fe" name="taskFE WorkPanel / TaskDetail [MOD v80]"/>
    <element xsi:type="archimate:ApplicationComponent" id="id-v80f-app-cloud" name="taskCloudService [MOD v80]"/>
    <element xsi:type="archimate:DataObject" id="id-v80f-do-cmt" name="cloud_server_configs comment CSC [MOD v80]"/>
    <element xsi:type="archimate:DataObject" id="id-v80f-do-tpl" name="cloud_server_configs task template [MOD v80]"/>
    <element xsi:type="archimate:DataObject" id="id-v80f-do-m" name="running_machine_count [NEW v80]"/>
    <element xsi:type="archimate:DataObject" id="id-v80f-do-c" name="running_container_count [NEW v80]"/>
  </folder>
  <folder name="Implementation &amp; Migration" id="id-v80full-im" type="implementation_migration">
    <element xsi:type="archimate:Plateau" id="id-v80f-pl-v79" name="Plateau v79"/>
    <element xsi:type="archimate:Plateau" id="id-v80f-pl-v80" name="Plateau v80"/>
    <element xsi:type="archimate:Gap" id="id-v80f-gap" name="Gap: task-level CSC still stores Starting/Running"/>
    <element xsi:type="archimate:WorkPackage" id="id-v80f-wp" name="WP: task-running-comment-counts"/>
  </folder>
  <folder name="Relations" id="id-v80full-rel" type="relations">
    <element xsi:type="archimate:FlowRelationship" id="id-v80f-rel-ind" source="id-v80f-app-fe" target="id-v80f-app-cloud" name="indicators + comment runtime-status"/>
    <element xsi:type="archimate:FlowRelationship" id="id-v80f-rel-cnt" source="id-v80f-app-cloud" target="id-v80f-app-fe" name="machines=N containers=M"/>
    <element xsi:type="archimate:AccessRelationship" id="id-v80f-rel-cmt" source="id-v80f-app-cloud" target="id-v80f-do-cmt" name="write runtime"/>
    <element xsi:type="archimate:AccessRelationship" id="id-v80f-rel-tpl" source="id-v80f-app-cloud" target="id-v80f-do-tpl" name="template only"/>
    <element xsi:type="archimate:AccessRelationship" id="id-v80f-rel-m" source="id-v80f-app-cloud" target="id-v80f-do-m" name="recompute"/>
    <element xsi:type="archimate:AccessRelationship" id="id-v80f-rel-c" source="id-v80f-app-cloud" target="id-v80f-do-c" name="recompute"/>
    <element xsi:type="archimate:AssociationRelationship" id="id-v80f-rel-pl79-gap" source="id-v80f-pl-v79" target="id-v80f-gap"/>
    <element xsi:type="archimate:RealizationRelationship" id="id-v80f-rel-wp-gap" source="id-v80f-wp" target="id-v80f-gap"/>
    <element xsi:type="archimate:AssociationRelationship" id="id-v80f-rel-wp-pl80" source="id-v80f-wp" target="id-v80f-pl-v80"/>
  </folder>
  <folder name="Views" id="id-v80full-views" type="diagrams">
    <element xsi:type="archimate:ArchimateDiagramModel" id="id-v80f-view-topo" name="v80 全量拓扑 — task running counts">
      <child xsi:type="archimate:DiagramObject" id="id-v80f-d-fe" archimateElement="id-v80f-app-fe">
        <bounds x="48" y="48" width="220" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v80f-c-ind" source="id-v80f-d-fe" target="id-v80f-d-cloud" archimateRelationship="id-v80f-rel-ind"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v80f-d-cloud" targetConnections="id-v80f-c-ind" archimateElement="id-v80f-app-cloud">
        <bounds x="320" y="48" width="200" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v80f-c-cnt" source="id-v80f-d-cloud" target="id-v80f-d-fe" archimateRelationship="id-v80f-rel-cnt"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v80f-c-cmt" source="id-v80f-d-cloud" target="id-v80f-d-cmt" archimateRelationship="id-v80f-rel-cmt"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v80f-c-tpl" source="id-v80f-d-cloud" target="id-v80f-d-tpl" archimateRelationship="id-v80f-rel-tpl"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v80f-c-m" source="id-v80f-d-cloud" target="id-v80f-d-m" archimateRelationship="id-v80f-rel-m"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v80f-c-c" source="id-v80f-d-cloud" target="id-v80f-d-c" archimateRelationship="id-v80f-rel-c"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v80f-d-cmt" targetConnections="id-v80f-c-cmt" archimateElement="id-v80f-do-cmt">
        <bounds x="48" y="160" width="220" height="55"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v80f-d-tpl" targetConnections="id-v80f-c-tpl" archimateElement="id-v80f-do-tpl">
        <bounds x="280" y="160" width="220" height="55"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v80f-d-m" targetConnections="id-v80f-c-m" archimateElement="id-v80f-do-m">
        <bounds x="520" y="160" width="180" height="55"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v80f-d-c" targetConnections="id-v80f-c-c" archimateElement="id-v80f-do-c">
        <bounds x="720" y="160" width="200" height="55"/>
      </child>
    </element>
    <element xsi:type="archimate:ArchimateDiagramModel" id="id-v80f-view-mig" name="架构变迁 v79→v80 — task-running-comment-counts">
      <child xsi:type="archimate:DiagramObject" id="id-v80f-do-pl79" archimateElement="id-v80f-pl-v79">
        <bounds x="48" y="48" width="140" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v80f-conn-pl79-gap" source="id-v80f-do-pl79" target="id-v80f-do-gap" archimateRelationship="id-v80f-rel-pl79-gap"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v80f-do-gap" targetConnections="id-v80f-conn-pl79-gap id-v80f-conn-wp-gap" archimateElement="id-v80f-gap">
        <bounds x="240" y="48" width="360" height="55"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v80f-do-wp" archimateElement="id-v80f-wp">
        <bounds x="240" y="160" width="280" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v80f-conn-wp-gap" source="id-v80f-do-wp" target="id-v80f-do-gap" archimateRelationship="id-v80f-rel-wp-gap"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v80f-conn-wp-pl80" source="id-v80f-do-wp" target="id-v80f-do-pl80" archimateRelationship="id-v80f-rel-wp-pl80"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v80f-do-pl80" targetConnections="id-v80f-conn-wp-pl80" archimateElement="id-v80f-pl-v80">
        <bounds x="580" y="160" width="140" height="55"/>
      </child>
    </element>
  </folder>
</archimate:model>
