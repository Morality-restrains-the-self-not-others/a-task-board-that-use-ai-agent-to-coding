    <element xsi:type="archimate:FlowRelationship" id="id-v121-el-rel-a-fe" source="id-v121-el-admin" target="id-v121-el-fe" name="CRUD"/>
    <element xsi:type="archimate:FlowRelationship" id="id-v121-el-rel-m-fe" source="id-v121-el-member" target="id-v121-el-fe" name="侧栏 GET"/>
    <element xsi:type="archimate:FlowRelationship" id="id-v121-el-rel-fe-bill" source="id-v121-el-fe" target="id-v121-el-bill" name="API"/>
    <element xsi:type="archimate:ServingRelationship" id="id-v121-el-rel-bill-nav" source="id-v121-el-bill" target="id-v121-el-nav" name="仅返回可见组"/>
    <element xsi:type="archimate:TriggeringRelationship" id="id-v121-el-rel-pl-gap" source="id-v121-el-pl119" target="id-v121-el-gap" name="identifies"/>
    <element xsi:type="archimate:RealizationRelationship" id="id-v121-el-rel-wp-gap" source="id-v121-el-wp" target="id-v121-el-gap"/>
    <element xsi:type="archimate:RealizationRelationship" id="id-v121-el-rel-wp-pl" source="id-v121-el-wp" target="id-v121-el-pl120"/>
  </folder>
  <folder name="Views" id="id-v121el-views" type="diagrams">
    <element xsi:type="archimate:ArchimateDiagramModel" id="id-v121-el-view-mig" name="架构变迁 v120→v121 — tenant-feedback-links-by-consumption">
      <child xsi:type="archimate:DiagramObject" id="id-v121-el-do-pl119" archimateElement="id-v121-el-pl119">
        <bounds x="48" y="48" width="200" height="50"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v121-el-c-pl-gap" source="id-v121-el-do-pl119" target="id-v121-el-do-gap" archimateRelationship="id-v121-el-rel-pl-gap"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v121-el-do-gap" targetConnections="id-v121-el-c-pl-gap id-v121-el-c-wp-gap" archimateElement="id-v121-el-gap">
        <bounds x="280" y="48" width="400" height="50"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v121-el-do-wp" archimateElement="id-v121-el-wp">
        <bounds x="280" y="140" width="400" height="50"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v121-el-c-wp-gap" source="id-v121-el-do-wp" target="id-v121-el-do-gap" archimateRelationship="id-v121-el-rel-wp-gap"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v121-el-c-wp-pl" source="id-v121-el-do-wp" target="id-v121-el-do-pl120" archimateRelationship="id-v121-el-rel-wp-pl"/>
