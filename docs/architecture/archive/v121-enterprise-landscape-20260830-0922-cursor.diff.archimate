<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="enterprise-landscape v121 变迁 (v120→v121)" id="id-v121eldiff01">
  <folder name="Business" id="id-v121el-biz" type="business">
    <element xsi:type="archimate:BusinessActor" id="id-v121-el-admin" name="平台超管"/>
    <element xsi:type="archimate:BusinessActor" id="id-v121-el-member" name="租户成员"/>
    <element xsi:type="archimate:BusinessProcess" id="id-v121-el-cfg" name="配置意见链接组"/>
    <element xsi:type="archimate:BusinessProcess" id="id-v121-el-nav" name="打开意见与建议子菜单"/>
  </folder>
  <folder name="Application" id="id-v121el-app" type="application">
    <element xsi:type="archimate:ApplicationComponent" id="id-v121-el-fe" name="taskFE"/>
    <element xsi:type="archimate:ApplicationComponent" id="id-v121-el-bill" name="taskBill"/>
  </folder>
  <folder name="Implementation &amp; Migration" id="id-v121el-im" type="implementation_migration">
    <element xsi:type="archimate:Plateau" id="id-v121-el-pl119" name="Plateau v120"/>
    <element xsi:type="archimate:Plateau" id="id-v121-el-pl120" name="Plateau v120"/>
    <element xsi:type="archimate:Gap" id="id-v121-el-gap" name="Gap: 无消耗分层意见入口"/>
    <element xsi:type="archimate:WorkPackage" id="id-v121-el-wp" name="WP-tenant-feedback-links"/>
  </folder>
  <folder name="Relations" id="id-v121el-rel" type="relations">
    <element xsi:type="archimate:AssignmentRelationship" id="id-v121-el-rel-as-a" source="id-v121-el-admin" target="id-v121-el-cfg"/>
