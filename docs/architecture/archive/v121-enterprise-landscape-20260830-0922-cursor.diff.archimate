      <child xsi:type="archimate:DiagramObject" id="id-v121-el-do-pl120" targetConnections="id-v121-el-c-wp-pl" archimateElement="id-v121-el-pl120">
        <bounds x="720" y="140" width="200" height="50"/>
      </child>
    </element>
    <element xsi:type="archimate:ArchimateDiagramModel" id="id-v121-el-view-topo" name="v121 Target — 意见与建议链接">
      <child xsi:type="archimate:DiagramObject" id="id-v121-el-do-admin" archimateElement="id-v121-el-admin">
        <bounds x="48" y="48" width="160" height="50"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v121-el-c-as-a" source="id-v121-el-do-admin" target="id-v121-el-do-cfg" archimateRelationship="id-v121-el-rel-as-a"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v121-el-c-a-fe" source="id-v121-el-do-admin" target="id-v121-el-do-fe" archimateRelationship="id-v121-el-rel-a-fe"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v121-el-do-member" archimateElement="id-v121-el-member">
        <bounds x="48" y="160" width="160" height="50"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v121-el-c-as-m" source="id-v121-el-do-member" target="id-v121-el-do-nav" archimateRelationship="id-v121-el-rel-as-m"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v121-el-c-m-fe" source="id-v121-el-do-member" target="id-v121-el-do-fe" archimateRelationship="id-v121-el-rel-m-fe"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v121-el-do-cfg" targetConnections="id-v121-el-c-as-a" archimateElement="id-v121-el-cfg">
        <bounds x="240" y="48" width="200" height="50"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v121-el-do-nav" targetConnections="id-v121-el-c-as-m id-v121-el-c-bill-nav" archimateElement="id-v121-el-nav">
        <bounds x="240" y="160" width="200" height="50"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v121-el-do-fe" targetConnections="id-v121-el-c-a-fe id-v121-el-c-m-fe" archimateElement="id-v121-el-fe">
        <bounds x="480" y="96" width="140" height="50"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v121-el-c-fe-bill" source="id-v121-el-do-fe" target="id-v121-el-do-bill" archimateRelationship="id-v121-el-rel-fe-bill"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v121-el-do-bill" targetConnections="id-v121-el-c-fe-bill" archimateElement="id-v121-el-bill">
        <bounds x="660" y="96" width="160" height="50"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v121-el-c-bill-nav" source="id-v121-el-do-bill" target="id-v121-el-do-nav" archimateRelationship="id-v121-el-rel-bill-nav"/>
