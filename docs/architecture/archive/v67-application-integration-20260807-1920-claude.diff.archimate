<?xml version="1.0" encoding="UTF-8"?>
<archimate:model
    xmlns="http://www.opengroup.org/xsd/archimate/3.0/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:archimate="http://www.archimatetool.com/archimate"
    xsi:schemaLocation="http://www.opengroup.org/xsd/archimate/3.0/ http://www.opengroup.org/xsd/archimate/3.1/archimate3_Diagram.xsd"
    identifier="model-v67-ai-20260807-1920">

  <name xml:lang="en">v67 任务帖存续期定价 — 创建帖次数 + 单帖续存</name>
  <purpose>任务帖定价模型重构 — server_start 执行费→创建帖费 (33分/帖/12个月) + server_start_renewal 续存单位；charge-server-start 剥离 no-op (taskBill+taskCloud bill_client 退役)；task_tasks.post_expires_at + POST /tasks/{id}/renew/ 续存接口 (扣1创建帖次数→+12M, max(now,cur)+12M 算法)；到期校验 (expired 帖拒绝执行/编辑/评论)；TASK_POST_RENEWED/TASK_POST_EXPIRED 事件 + taskEvents 每日到期扫描；存量帖上线日统一 +12M</purpose>

  <folder name="Business" id="f-biz" type="business"/>
  <folder name="Application" id="f-app" type="application"/>
  <folder name="Technology" id="f-tech" type="technology"/>
  <folder name="Implementation" id="f-impl" type="implementation_migration"/>
  <folder name="Relations" id="f-rel" type="relations"/>

  <!-- Application Layer — v67 任务帖存续期相关组件 -->
  <element xsi:type="archimate:ApplicationComponent" name="APISIX Gateway (:18081)" id="gateway"/>
  <element xsi:type="archimate:ApplicationComponent" name="taskTaskService (:8021) [MODIFIED v67: +post_expires_at +/tasks/{id}/renew/ +到期校验]" id="taskTask"/>
  <element xsi:type="archimate:ApplicationComponent" name="taskBill (:8004) [MODIFIED v67: server_start 执行费→创建帖费 +server_start_renewal +consume-task-post-renewal]" id="taskBill"/>
  <element xsi:type="archimate:ApplicationComponent" name="taskCloudService (:8018) [MODIFIED v67: bill_client chargeServerStart 退役]" id="taskCloud"/>
  <element xsi:type="archimate:ApplicationComponent" name="taskEvents (:8023) [MODIFIED v67: +TASK_POST_RENEWED/EXPIRED +每日到期扫描]" id="taskEvents"/>
  <element xsi:type="archimate:ApplicationComponent" name="charge-server-start 按次扣费 [DEPRECATED v67]" id="oldChargeServerStart"/>
  <element xsi:type="archimate:ApplicationDataObject" name="taskTask DB (+post_expires_at 🆕)" id="taskTaskDB"/>
  <element xsi:type="archimate:ApplicationDataObject" name="taskBill DB (+server_start_renewal 单位)" id="taskBillDB"/>
  <element xsi:type="archimate:ApplicationEvent" name="TASK_POST_RENEWED 🆕" id="evtPostRenewed"/>
  <element xsi:type="archimate:ApplicationEvent" name="TASK_POST_EXPIRED 🆕" id="evtPostExpired"/>
  <element xsi:type="archimate:ApplicationDataObject" name="Kafka" id="kafkaBroker"/>

  <!-- Implementation & Migration — v67 架构变迁 -->
  <element xsi:type="archimate:Plateau" name="Plateau v66 — 多会话互知 (2026-08-06)" id="plateauV66"/>
  <element xsi:type="archimate:Plateau" name="Plateau v67 — 任务帖存续期 (2026-08-07)" id="plateauV67"/>
  <element xsi:type="archimate:Gap" name="Gap: 帖子无存续期概念、执行按次扣费、无续存入口" id="gapPost"/>
  <element xsi:type="archimate:WorkPackage" name="WP-post-lifecycle (P1 DB迁移+存量回填 → P2 taskBill 计费改造 → P3 taskTask 存续期/renew → P4 events/扫描 → P5 FE)" id="wpPost"/>

  <!-- Relationships -->
  <element xsi:type="archimate:FlowRelationship" id="rel-gw-task" source="gateway" target="taskTask"/>
  <element xsi:type="archimate:FlowRelationship" id="rel-gw-bill" source="gateway" target="taskBill"/>
  <element xsi:type="archimate:ServingRelationship" id="rel-task-bill" source="taskTask" target="taskBill"/>
  <element xsi:type="archimate:AccessRelationship" id="rel-task-db" source="taskTask" target="taskTaskDB" accessType="write"/>
  <element xsi:type="archimate:AccessRelationship" id="rel-bill-db" source="taskBill" target="taskBillDB" accessType="write"/>
  <element xsi:type="archimate:FlowRelationship" id="rel-task-renewed" source="taskTask" target="evtPostRenewed"/>
  <element xsi:type="archimate:FlowRelationship" id="rel-events-expired" source="taskEvents" target="evtPostExpired"/>
  <element xsi:type="archimate:FlowRelationship" id="rel-renewed-kafka" source="evtPostRenewed" target="kafkaBroker"/>
  <element xsi:type="archimate:FlowRelationship" id="rel-expired-kafka" source="evtPostExpired" target="kafkaBroker"/>
  <element xsi:type="archimate:ServingRelationship" id="rel-cloud-old" source="taskCloud" target="oldChargeServerStart"/>
  <element xsi:type="archimate:AssociationRelationship" id="rel-old-bill" source="oldChargeServerStart" target="taskBill"/>
  <element xsi:type="archimate:TriggeringRelationship" id="rel-trigger" source="plateauV66" target="gapPost"/>
  <element xsi:type="archimate:RealizationRelationship" id="rel-wp-gap" source="wpPost" target="gapPost"/>
  <element xsi:type="archimate:RealizationRelationship" id="rel-wp-plat" source="wpPost" target="plateauV67"/>

  <folder name="Views" id="f-views" type="diagrams">
    <!-- 视图 1: 架构变迁 v66→v67 -->
    <element xsi:type="archimate:ArchiMateDiagramModel" name="架构变迁 v66→v67 — 任务帖存续期" id="view-migration">
      <child xsi:type="archimate:DiagramObject" id="do-plateauV66" archimateElement="plateauV66">
        <bounds x="48" y="120" width="220" height="50"/>
        <sourceConnection xsi:type="archimate:Connection" id="conn-v66-gap" source="do-plateauV66" target="do-gapPost" archimateRelationship="rel-trigger"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="do-gapPost" archimateElement="gapPost" targetConnections="conn-v66-gap conn-wp-gap">
        <bounds x="300" y="120" width="300" height="60"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="do-wpPost" archimateElement="wpPost">
        <bounds x="640" y="80" width="300" height="60"/>
        <sourceConnection xsi:type="archimate:Connection" id="conn-wp-gap" source="do-wpPost" target="do-gapPost" archimateRelationship="rel-wp-gap"/>
        <sourceConnection xsi:type="archimate:Connection" id="conn-wp-v67" source="do-wpPost" target="do-plateauV67" archimateRelationship="rel-wp-plat"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="do-plateauV67" archimateElement="plateauV67" targetConnections="conn-wp-v67">
        <bounds x="640" y="180" width="300" height="50"/>
      </child>
    </element>

    <!-- 视图 2: v67 Target — 创建/续存/到期数据流 -->
    <element xsi:type="archimate:ArchiMateDiagramModel" name="v67 Target — 创建/续存/到期数据流" id="view-topology">
      <child xsi:type="archimate:DiagramObject" id="do-gateway" archimateElement="gateway">
        <bounds x="40" y="60" width="160" height="50"/>
        <sourceConnection xsi:type="archimate:Connection" id="conn-gw-task" source="do-gateway" target="do-taskTask" archimateRelationship="rel-gw-task"/>
        <sourceConnection xsi:type="archimate:Connection" id="conn-gw-bill" source="do-gateway" target="do-taskBill" archimateRelationship="rel-gw-bill"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="do-taskTask" archimateElement="taskTask" targetConnections="conn-gw-task">
        <bounds x="300" y="60" width="220" height="60"/>
        <sourceConnection xsi:type="archimate:Connection" id="conn-task-bill" source="do-taskTask" target="do-taskBill" archimateRelationship="rel-task-bill"/>
        <sourceConnection xsi:type="archimate:Connection" id="conn-task-db" source="do-taskTask" target="do-taskTaskDB" archimateRelationship="rel-task-db"/>
        <sourceConnection xsi:type="archimate:Connection" id="conn-task-renewed" source="do-taskTask" target="do-evtPostRenewed" archimateRelationship="rel-task-renewed"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="do-taskBill" archimateElement="taskBill" targetConnections="conn-gw-bill conn-task-bill conn-old-bill">
        <bounds x="580" y="60" width="220" height="60"/>
        <sourceConnection xsi:type="archimate:Connection" id="conn-bill-db" source="do-taskBill" target="do-taskBillDB" archimateRelationship="rel-bill-db"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="do-taskTaskDB" archimateElement="taskTaskDB" targetConnections="conn-task-db">
        <bounds x="300" y="180" width="220" height="50"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="do-taskBillDB" archimateElement="taskBillDB" targetConnections="conn-bill-db">
        <bounds x="580" y="180" width="220" height="50"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="do-evtPostRenewed" archimateElement="evtPostRenewed" targetConnections="conn-task-renewed">
        <bounds x="300" y="270" width="220" height="50"/>
        <sourceConnection xsi:type="archimate:Connection" id="conn-renewed-kafka" source="do-evtPostRenewed" target="do-kafkaBroker" archimateRelationship="rel-renewed-kafka"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="do-taskEvents" archimateElement="taskEvents">
        <bounds x="40" y="270" width="180" height="60"/>
        <sourceConnection xsi:type="archimate:Connection" id="conn-events-expired" source="do-taskEvents" target="do-evtPostExpired" archimateRelationship="rel-events-expired"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="do-evtPostExpired" archimateElement="evtPostExpired" targetConnections="conn-events-expired">
        <bounds x="40" y="370" width="180" height="50"/>
        <sourceConnection xsi:type="archimate:Connection" id="conn-expired-kafka" source="do-evtPostExpired" target="do-kafkaBroker" archimateRelationship="rel-expired-kafka"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="do-kafkaBroker" archimateElement="kafkaBroker" targetConnections="conn-renewed-kafka conn-expired-kafka">
        <bounds x="300" y="370" width="220" height="50"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="do-taskCloud" archimateElement="taskCloud">
        <bounds x="580" y="270" width="220" height="60"/>
        <sourceConnection xsi:type="archimate:Connection" id="conn-cloud-old" source="do-taskCloud" target="do-oldChargeServerStart" archimateRelationship="rel-cloud-old"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="do-oldChargeServerStart" archimateElement="oldChargeServerStart" targetConnections="conn-cloud-old">
        <bounds x="580" y="370" width="220" height="60"/>
        <sourceConnection xsi:type="archimate:Connection" id="conn-old-bill" source="do-oldChargeServerStart" target="do-taskBill" archimateRelationship="rel-old-bill"/>
      </child>
    </element>
  </folder>
</archimate:model>
