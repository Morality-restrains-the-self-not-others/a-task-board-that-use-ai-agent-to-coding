    identifier="model-v17-full-20260809">

  <name xml:lang="en">v17 全量 — 移除本机模拟启动 (post-change)</name>
  <purpose>基线回填 v11（2026-07-07）之后的结构性变化 — 全量 Go 微服务拓扑、Django saas-backend 完全退役、RBAC 集中授权（PDP + shareLib/authz）、微信身份统一
v13 全量模型：合并「Git Hooks 入库」变更后的完整架构。
v14 全量模型：合并「多会话互知」变更后的完整架构。
v15 全量模型：合并「任务帖存续期」变更后的完整架构。
v16 全量模型：合并「插件 OIDC 白名单管理」变更后的完整架构。
v17 全量模型：合并「移除本机模拟启动」变更后的完整架构 — 🔴 mock_run_container/go_run_container 本机 Docker 模拟运行器删除、taskContainerGateway mock-run-container 代理面删除、taskCloudService /api/internal/mock-run/* 删除、taskFE「模拟启动」面板删除；容器启动统一走云端机器（start-vm → CLOUD_SERVER_STARTED → ECS）。</purpose>

  <folder name="Business" id="f-biz" type="business"/>
  <folder name="Application" id="f-app" type="application"/>
  <folder name="Technology" id="f-tech" type="technology"/>
  <folder name="Implementation" id="f-impl" type="implementation_migration"/>
  <folder name="Relations" id="f-rel" type="relations"/>

