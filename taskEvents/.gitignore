# 忽略 bin/ 下所有构建产物，保留目录说明文档
/bin/**
!/bin/
!/bin/README.md
/logs/
/data/
*.pid
.DS_Store

# Misnamed go build output when cwd is src/ (use bin/ instead)
/src/src
