# Nested independent git repositories under this meta-repo.
# Canonical remote: git@github.com:task2money/<repo>.git
# These paths remain separately cloned and listed in .gitignore; this file is
# the Git-standard path↔url registry used for discovery (not full gitlink checkout).
# Remote 命名约定（OPT-20260904-001）: origin = GitHub 镜像（规范 remote，日常 push 走它）；
# gitlab = 私有主站 GitLab git@gitlab.daydaymoney.com（仅已配置主站镜像的仓库才设置，禁止把
# gitlab 设成 github URL —— 曾致 24 子仓 gitlab==origin 重复、删分支打错端）；
# gitlab-sh-1 = 腾讯侧 gitlab-tencent-sh-1.daydaymoney.com。2026-09-05 已清理本地冗余 remote。
[submodule "DaydaymoneyGrafana"]
	path = DaydaymoneyGrafana
	url = git@github.com:task2money/DaydaymoneyGrafana.git
