#!/bin/bash
# Go + 前端 unit 测例仓库（如 taskAiProvider）：
# 先跑 Go 包随机抽测，再跑 frontend *.unit.test.js 随机抽测。
# 库: scripts/hooks/lib/random_test_runner.sh（SSOT，由 deploy_repo_random_precommit.sh 分发）

set -u

HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
LIB="$HOOK_DIR/lib/random_test_runner.sh"
if [ ! -f "$LIB" ]; then
    echo "ERROR: shared lib missing: $LIB" >&2
    echo "       redeploy: bash <monorepo-root>/scripts/deploy_repo_random_precommit.sh" >&2
    exit 1
fi
source "$LIB"

cleanup() {
    echo "如果有测例失败，记得修复"
    echo "如果提交失败，记得先尝试修复，不行再忽略测例"
}
trap cleanup EXIT

# 仅变更 hooks/文档时跳过抽测，便于自举提交钩子模板（非 --no-verify）
rt_bootstrap_skip && exit 0

cd "$(git rev-parse --show-toplevel)" || exit 1

echo "=== [1/2] Go random unit tests ==="
export PRE_COMMIT=1
TEST_RATIO="${PRECOMMIT_TEST_RATIO:-30}"
STAGED_FILES="$(git diff --cached --name-only 2>/dev/null || true)"

TMP_ALL="$(mktemp)"
TMP_STAGED="$(mktemp)"
TMP_TO_RUN="$(mktemp)"
trap 'rm -f "$TMP_ALL" "$TMP_STAGED" "$TMP_TO_RUN"; cleanup' EXIT

rt_go_collect_dirs > "$TMP_ALL"
if [ -s "$TMP_ALL" ]; then
    # 暂存 100%
    while IFS= read -r f; do
        [ -z "$f" ] && continue
        dir="$(rt_go_dir_for_file "$f" 2>/dev/null)" || continue
        if rt_go_dir_has_tests "$dir"; then
            echo "$dir" >> "$TMP_STAGED"
        fi
    done <<< "$STAGED_FILES"
    if [ -s "$TMP_STAGED" ]; then
        sort -u "$TMP_STAGED" -o "$TMP_STAGED"
        echo "Running staged Go test packages..."
        while IFS= read -r dir; do
            [ -z "$dir" ] && continue
            rt_go_run_dir "$dir" || exit 1
        done < "$TMP_STAGED"
    fi
    # 随机抽测
    echo "Running random Go test packages (ratio=${TEST_RATIO}%)..."
    if [ -s "$TMP_STAGED" ]; then
        grep -vxFf "$TMP_STAGED" "$TMP_ALL" | rt_pick_random "$TEST_RATIO" > "$TMP_TO_RUN"
    else
        rt_pick_random "$TEST_RATIO" < "$TMP_ALL" > "$TMP_TO_RUN"
    fi
    while IFS= read -r dir; do
        [ -z "$dir" ] && continue
        echo "Random pick: ${dir}"
        rt_go_run_dir "$dir" || exit 1
    done < "$TMP_TO_RUN"
else
    echo "No Go test packages found."
fi
rm -f "$TMP_ALL" "$TMP_STAGED" "$TMP_TO_RUN"

echo "=== [2/2] Frontend unit tests (vitest/node) ==="
if [ -d frontend ]; then
    rt_js_collect_files | grep '^frontend/' > "$TMP_ALL"
    if [ -s "$TMP_ALL" ]; then
        # 暂存 100%
        : > "$TMP_STAGED"
        while IFS= read -r test_file; do
            [ -z "$test_file" ] && continue
            if echo "$STAGED_FILES" | grep -qxF "$test_file" 2>/dev/null; then
                echo "$test_file" >> "$TMP_STAGED"
            fi
        done < "$TMP_ALL"
        if [ -s "$TMP_STAGED" ]; then
            echo "Running staged frontend tests..."
            while IFS= read -r test_file; do
                [ -z "$test_file" ] && continue
                rt_js_run_file "$test_file" || exit 1
            done < "$TMP_STAGED"
        fi
        # 随机抽测
        echo "Running random frontend tests (ratio=${TEST_RATIO}%)..."
        if [ -s "$TMP_STAGED" ]; then
            grep -vxFf "$TMP_STAGED" "$TMP_ALL" | rt_pick_random "$TEST_RATIO" > "$TMP_TO_RUN"
        else
            rt_pick_random "$TEST_RATIO" < "$TMP_ALL" > "$TMP_TO_RUN"
        fi
        while IFS= read -r test_file; do
            [ -z "$test_file" ] && continue
            echo "Random pick: ${test_file}"
            rt_js_run_file "$test_file" || exit 1
        done < "$TMP_TO_RUN"
    else
        echo "No frontend unit tests found."
    fi
else
    echo "No frontend/ package; skip JS unit tests."
fi

echo "All Go+JS unit tests passed. Commit can proceed."
