DRY_RUN=true bash db/scripts/ensure_partitions.sh

# 查看表的分区状态
mysql -e "SELECT TABLE_NAME, PARTITION_NAME, TABLE_ROWS FROM information_schema.partitions WHERE TABLE_SCHEMA='task_bill' AND PARTITION_NAME IS NOT NULL ORDER BY TABLE_NAME, PARTITION_ORDINAL_POSITION"

# 运行 CI 检查
bash dataMigrate/check_cold_hot_separation.sh
```

