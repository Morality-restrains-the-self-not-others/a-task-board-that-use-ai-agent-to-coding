#!/bin/bash
# Node 仓库 pre-commit（共享库版 random_test_runner.sh）：
# 1) 优先运行暂存的 *.test.mjs / *.test.js / *.unit.test.js / *.test.ts
# 2) 对其余测例按比例随机抽测（默认 30%，保证至少 1 个）
# 3) 任一测试失败则阻止提交
# 库: scripts/hooks/lib/random_test_runner.sh（SSOT，由 deploy_repo_random_precommit.sh 分发）

set -u

HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
LIB="$HOOK_DIR/lib/random_test_runner.sh"
if [ ! -f "$LIB" ]; then
    echo "ERROR: shared lib missing: $LIB" >&2
    echo "       redeploy: bash <monorepo-root>/scripts/deploy_repo_random_precommit.sh" >&2
    exit 1
fi
source "$LIB"
# Session Hub 提交锁校验（v1.1.0，可选 — 二进制缺失时放行）
SES_LIB="$HOOK_DIR/lib/session_lock_check.sh"
if [ -f "$SES_LIB" ]; then source "$SES_LIB"; session_hub_lock_check; fi
# gitignored deploy-binaries refresh (fail-open; no-op outside the meta checkout)
_COLLECT="$(cd "$(dirname "$0")/../.." && pwd)/scripts/lib/collect-deploy-binaries-on-commit.sh"
if [ -x "$_COLLECT" ]; then bash "$_COLLECT" || true; fi
unset _COLLECT

cleanup() {
    echo "如果有测例失败，记得修复"
    echo "如果提交失败，记得先尝试修复，不行再忽略测例"
}
trap cleanup EXIT

# 仅变更 hooks/文档时跳过抽测，便于自举提交钩子模板（非 --no-verify）
rt_bootstrap_skip && exit 0

cd "$(git rev-parse --show-toplevel)" || exit 1

echo "Running pre-commit Node tests in $(pwd)..."
export PRE_COMMIT=1
TEST_RATIO="${PRECOMMIT_TEST_RATIO:-30}"
STAGED_FILES="$(git diff --cached --name-only 2>/dev/null || true)"

# OPT-20260818-004: 顶层 vi.mock 但无 VITEST 护栏的 *.test.js 在 pre-commit 的
# node --test 直跑下会崩溃（Vitest mocker 未初始化），静态阻断以防再次引入。
if [ -n "$STAGED_FILES" ]; then
    while IFS= read -r test_file; do
        [ -z "$test_file" ] && continue
        case "$test_file" in
            *.test.js|*.test.mjs|*.unit.test.js)
                if grep -q 'vi\.mock(' "$test_file" 2>/dev/null \
                   && ! grep -q 'process\.env\.VITEST' "$test_file" 2>/dev/null; then
                    echo "ERROR: $test_file 使用 vi.mock 但缺少 VITEST 护栏（OPT-20260818-004）" >&2
                    echo "       pre-commit 以 node --test 直跑时 Vitest mocker 未初始化会崩溃。" >&2
                    echo "       请把 vi.mock 包进 if (!process.env.VITEST) {...} / dynamic import 块内。" >&2
                    exit 1
                fi
                ;;
        esac
    done <<< "$STAGED_FILES"
fi

TMP_ALL="$(mktemp)"
TMP_STAGED="$(mktemp)"
TMP_TO_RUN="$(mktemp)"
trap 'rm -f "$TMP_ALL" "$TMP_STAGED" "$TMP_TO_RUN"; cleanup' EXIT

rt_js_collect_files > "$TMP_ALL"
if [ ! -s "$TMP_ALL" ]; then
    echo "No Node test files found. Commit can proceed."
    exit 0
fi

# 暂存 100%
while IFS= read -r test_file; do
    [ -z "$test_file" ] && continue
    if echo "$STAGED_FILES" | grep -qxF "$test_file" 2>/dev/null; then
        echo "$test_file" >> "$TMP_STAGED"
    fi
done < "$TMP_ALL"

if [ -s "$TMP_STAGED" ]; then
    echo "Running staged Node tests..."
    while IFS= read -r test_file; do
        [ -z "$test_file" ] && continue
        rt_js_run_file "$test_file" || exit 1
    done < "$TMP_STAGED"
fi

# 随机抽测（排除暂存文件）
echo "Running random Node tests (ratio=${TEST_RATIO}%)..."
if [ -s "$TMP_STAGED" ]; then
    grep -vxFf "$TMP_STAGED" "$TMP_ALL" | rt_pick_random "$TEST_RATIO" > "$TMP_TO_RUN"
else
    rt_pick_random "$TEST_RATIO" < "$TMP_ALL" > "$TMP_TO_RUN"
fi
while IFS= read -r test_file; do
    [ -z "$test_file" ] && continue
    echo "Random pick: ${test_file}"
    rt_js_run_file "$test_file" || exit 1
done < "$TMP_TO_RUN"

echo "All Node unit tests passed. Commit can proceed."
